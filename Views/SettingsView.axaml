<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ReviFlash.Views.Controls"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:utilities="using:ReviFlash.Utilities"
    x:Class="ReviFlash.Views.SettingsView"
    x:DataType="vm:SettingsViewModel"
    Background="{DynamicResource AppBackground}">

    <UserControl.Styles>
        <!-- A setting: its name (and any note under it) on the left, its control on the right, a hairline under each. -->
        <Style Selector="HeaderedContentControl.settingRow">
            <Setter Property="Template">
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,16">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="24">
                            <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}"
                                VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                            <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="48,4,24,32" />
        </Style>
        <Style Selector="StackPanel.section > TextBlock.title">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Button.rowButton">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- The section list down the left. -->
        <Style Selector="TabControl.sections">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl.sections TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabControl.sections TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TabControl.sections TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBackground}" />
        </Style>
        <Style Selector="TabControl.sections TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
        </Style>
        <Style Selector="TabControl.sections TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" Margin="32,24,32,0">
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <Button Classes="secondary" Content="← Back" Click="Back_Click" Height="38" Padding="12,0"
                VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Back (Esc)" />
            <TextBlock Classes="title" Text="Settings" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Sections listed on the left; the chosen one fills the rest of the page. -->
        <TabControl Grid.Row="1" x:Name="Sections" Classes="sections" TabStripPlacement="Left">
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="Appearance" />

                        <HeaderedContentControl Classes="settingRow" Header="Theme">
                            <Button Classes="secondary rowButton" Content="{Binding SelectedTheme}" Click="ChooseTheme_Click"
                                ToolTip.Tip="Choose a theme or make your own" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Classes="settingRow">
                            <HeaderedContentControl.Header>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="LaTeX font for card text" />
                                    <TextBlock Classes="caption" Text="Cards use the LaTeX font throughout instead of Source Serif." />
                                </StackPanel>
                            </HeaderedContentControl.Header>
                            <CheckBox IsChecked="{Binding UseLatexFontForCards}" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Classes="settingRow">
                            <HeaderedContentControl.Header>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Previews for extra fields" />
                                    <TextBlock Classes="caption" Text="Show how options, pairs and typed answers will look, under each one in the editor." />
                                </StackPanel>
                            </HeaderedContentControl.Header>
                            <CheckBox IsChecked="{Binding ShowAdditionalFieldLatexPreviews}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Review">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="Review" />
                        <TextBlock Classes="caption" Text="What shows around the card while you study." Margin="0,0,0,8" />

                        <HeaderedContentControl Classes="settingRow" Header="Timer">
                            <CheckBox IsChecked="{Binding ShowTimer}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="Progress">
                            <CheckBox IsChecked="{Binding ShowProgress}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="Skip button">
                            <CheckBox IsChecked="{Binding ShowSkipButton}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="Retry later button">
                            <CheckBox IsChecked="{Binding ShowRetryLaterButton}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="Answer streak">
                            <CheckBox IsChecked="{Binding ShowAnswerStreakInReview}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Backup and import">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="Backup and import" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,0,0,8"
                            Text="Save everything to a backup zip, or restore the app from one." />

                        <HeaderedContentControl Classes="settingRow" Header="Include stats in backups">
                            <CheckBox x:Name="IncludeStatsInBackupCheckBox" IsChecked="True" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Classes="settingRow" Header="Backup">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="secondary rowButton" Content="Create backup" Click="CreateBackup_Click" />
                                <Button Classes="secondary rowButton" Content="Restore backup" Click="RestoreBackup_Click" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <TextBlock x:Name="BackupStatusText" Classes="caption" TextWrapping="Wrap" IsVisible="False" Margin="0,10,0,0" />

                        <HeaderedContentControl Classes="settingRow">
                            <HeaderedContentControl.Header>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Import from Anki" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                        Text="Add the decks from an .apkg file. Text, formatting, LaTeX, images, cloze, type-in and reversed cards all come across, and sub-decks become folders. Sounds are left out." />
                                </StackPanel>
                            </HeaderedContentControl.Header>
                            <Button x:Name="AnkiImportButton" Classes="secondary rowButton" Content="Import Anki deck" Click="ImportAnki_Click" />
                        </HeaderedContentControl>
                        <TextBlock x:Name="AnkiImportStatusText" Classes="caption" TextWrapping="Wrap" IsVisible="False" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="Updates" />

                        <HeaderedContentControl Classes="settingRow" Header="Check for updates when ReviFlash opens">
                            <CheckBox IsChecked="{Binding CheckForUpdatesOnStartup}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="Show what's new after an update">
                            <CheckBox IsChecked="{Binding ShowChangelogAfterUpdate}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="{x:Static utilities:TextUtility.VersionText}">
                            <Button Classes="secondary rowButton" Content="Check now" Click="CheckForUpdates_Click" />
                        </HeaderedContentControl>

                        <DockPanel Margin="0,10,0,0">
                            <controls:BusySpinner x:Name="UpdateSpinner" DockPanel.Dock="Left" IsVisible="False" Margin="0,0,8,0" />
                            <TextBlock x:Name="UpdateStatusText" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Account">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="Account" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding !IsSignedIn}"
                            Text="Sign in to share sets and notes, keep private copies, and download community sets and notes." />

                        <HeaderedContentControl Classes="settingRow" Header="{Binding AccountText}">
                            <Panel>
                                <Button Classes="secondary rowButton" Content="Sign out" Click="SignOut_Click" IsVisible="{Binding IsSignedIn}" />
                                <Button Classes="primary rowButton" Content="Sign in" Click="SignIn_Click" IsVisible="{Binding !IsSignedIn}" />
                            </Panel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="Username" IsVisible="{Binding IsSignedIn}">
                            <Button Classes="secondary rowButton" Content="Change username" Click="ChangeUsername_Click" />
                        </HeaderedContentControl>

                        <DockPanel Margin="0,10,0,0">
                            <controls:BusySpinner x:Name="AccountSpinner" DockPanel.Dock="Left" IsVisible="False" Margin="0,0,8,0" />
                            <TextBlock x:Name="AccountStatusText" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Danger zone">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="Danger zone" Foreground="{DynamicResource DangerForeground}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,0,0,8"
                            Text="Delete your stats, for everything or for one set. Your sets and notes are not affected. This can't be undone." />

                        <HeaderedContentControl Classes="settingRow" Header="Every stat, time and streak">
                            <Button Classes="danger rowButton" Content="Delete all stats" Click="DeleteAllStats_Click" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Classes="settingRow" Header="One set's stats">
                            <Button Classes="danger rowButton" Content="Choose a set…" Click="OpenDeleteDeckStats_Click" />
                        </HeaderedContentControl>

                        <TextBlock x:Name="DeleteStatsStatusText" Classes="caption" TextWrapping="Wrap" IsVisible="False" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
