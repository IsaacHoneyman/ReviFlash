<controls:DialogView xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ReviFlash.Views.Controls"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.DeleteDeckStatsDialog"
    x:DataType="vm:DeleteDeckStatsViewModel"
    Width="520" Height="620">

    <Border Classes="dialogShell">
        <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" RowSpacing="12">
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Classes="title" Text="Delete Set Stats" />
                <TextBlock Classes="caption" Text="Choose a set to clear its stats. Its cards are not affected. This cannot be undone."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Classes="card compact" Padding="12">
                <views:DeckFolderBrowserView DataContext="{Binding DeckBrowser}" />
            </Border>

            <TextBlock Grid.Row="2" Classes="heading"
                Text="{Binding SelectedDeck.Name, StringFormat='Selected: {0}', FallbackValue='No set selected'}"
                TextTrimming="CharacterEllipsis" />

            <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0" Classes="wide secondary" Content="Close" Click="Close_Click" IsCancel="True" />
                <Button Grid.Column="1" Classes="wide danger" Content="Delete This Set's Stats" Click="DeleteDeckStats_Click"
                    IsEnabled="{Binding SelectedDeck, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>

            <TextBlock Grid.Row="4" Classes="caption" Text="{Binding StatusMessage}"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                TextWrapping="Wrap" />
        </Grid>
    </Border>
</controls:DialogView>
