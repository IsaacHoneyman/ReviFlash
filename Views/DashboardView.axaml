<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:models="using:ReviFlash.Models"
    xmlns:utilities="using:ReviFlash.Utilities"
    xmlns:controls="using:ReviFlash.Views.Controls"
    x:Class="ReviFlash.Views.DashboardView"
    x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ReviFlash/Views/Controls/LibraryCard.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Library card text: the count in its badge, then the hint lines under the name. -->
        <Style Selector="TextBlock.badgeCount">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.badgeLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cardHint">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Sidebar stat tile: Header is the label, Content the value. -->
        <Style Selector="HeaderedContentControl.statTile">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource StatTileBackground}" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <ContentPresenter Content="{TemplateBinding Header}"
                                FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Graph view tile, spaced by margin (the uniform grid it sits in has no spacing of its own); long values shrink to fit. -->
        <Style Selector="HeaderedContentControl.graphTile">
            <Setter Property="Margin" Value="7,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource StatTileBackground}" CornerRadius="16" Padding="18">
                        <StackPanel>
                            <ContentPresenter Content="{TemplateBinding Header}"
                                FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                    FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </Viewbox>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ComboBox.timePeriod">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- Leaves the stats or graph view. -->
        <Style Selector="Button.exit">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.exit /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- Study calendar squares: empty, then the theme colour stronger with more time studied. -->
        <Style Selector="Border.heat">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="1.5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Border.heat.l1">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Border.heat.l2">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.heat.l3">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Border.heat.l4">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
        </Style>
        <Style Selector="Border.heat.future">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TextBlock.heatDayLabel">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:DashboardViewModel+TimePeriodOption">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:Folder}">
            <controls:LibraryCard Title="{Binding Name}" Icon="{StaticResource IconFolder}"
                BorderBrush="{DynamicResource FolderCardBorder}" BadgeBrush="{DynamicResource FolderCardBorder}"
                PointerPressed="Card_Click" KeyDown="Card_KeyDown">
                <controls:LibraryCard.Badge>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="badgeCount" Text="{Binding ItemCount}" Foreground="{DynamicResource FolderBadgeForeground}" />
                        <TextBlock Classes="badgeLabel" Text="Items" Foreground="{DynamicResource FolderBadgeForeground}" />
                    </StackPanel>
                </controls:LibraryCard.Badge>
                <controls:LibraryCard.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="iconButton" Click="RenameFolder_Click" ToolTip.Tip="Rename Folder">
                            <Path Classes="icon" Data="{StaticResource IconEdit}" />
                        </Button>
                        <Button Classes="iconButton" Click="MoveItem_Click" ToolTip.Tip="Move to Folder">
                            <Path Classes="icon" Data="{StaticResource IconFolder}" />
                        </Button>
                        <Button Classes="iconButton" Click="DeleteFolder_Click" ToolTip.Tip="Delete Folder (keeps its contents)">
                            <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                        </Button>
                    </StackPanel>
                </controls:LibraryCard.Actions>

                <TextBlock Classes="cardHint" MaxLines="1">
                    <Run Text="{Binding ContentsSummary}" /><Run Text="{Binding LocationSuffix}" />
                </TextBlock>
            </controls:LibraryCard>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:StudyGroup}">
            <controls:LibraryCard Title="{Binding Name}"
                BorderBrush="{DynamicResource GroupCardBorder}" BadgeBrush="{DynamicResource GroupCardBorder}"
                PointerPressed="Card_Click" KeyDown="Card_KeyDown">
                <controls:LibraryCard.Badge>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="badgeCount" Text="{Binding DeckCount}" Foreground="{DynamicResource GroupBadgeForeground}" />
                        <TextBlock Classes="badgeLabel" Text="Decks" Foreground="{DynamicResource GroupBadgeForeground}" />
                    </StackPanel>
                </controls:LibraryCard.Badge>
                <controls:LibraryCard.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="iconButton" Click="EditGroup_Click" ToolTip.Tip="Edit Group">
                            <Path Classes="icon" Data="{StaticResource IconEdit}" />
                        </Button>
                        <Button Classes="iconButton" Click="GroupStats_Click" ToolTip.Tip="View Group Stats">
                            <Path Classes="icon" Data="{StaticResource IconStats}" />
                        </Button>
                        <Button Classes="iconButton" Click="MoveItem_Click" ToolTip.Tip="Move to Folder">
                            <Path Classes="icon" Data="{StaticResource IconFolder}" />
                        </Button>
                        <Button Classes="iconButton" Click="DeleteGroup_Click" ToolTip.Tip="Delete Group">
                            <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                        </Button>
                    </StackPanel>
                </controls:LibraryCard.Actions>

                <StackPanel>
                    <TextBlock Classes="cardHint" Text="Click to review group" FontSize="14" IsVisible="{Binding ShowReviewHint}" />
                    <TextBlock Classes="cardHint" Text="{Binding FolderPath, StringFormat='in {0}'}" IsVisible="{Binding ShowLocationHint}" />
                </StackPanel>
            </controls:LibraryCard>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:FlashCardDeck}">
            <controls:LibraryCard Title="{Binding Name}"
                PointerPressed="Card_Click" KeyDown="Card_KeyDown">
                <controls:LibraryCard.Badge>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="badgeCount" Text="{Binding CardCount}" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Classes="badgeLabel" Text="Cards" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </controls:LibraryCard.Badge>
                <controls:LibraryCard.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="iconButton" Click="EditDeck_Click" ToolTip.Tip="Edit Set">
                            <Path Classes="icon" Data="{StaticResource IconEdit}" />
                        </Button>
                        <Button Classes="iconButton" Click="DeckStats_Click" ToolTip.Tip="View Set Stats">
                            <Path Classes="icon" Data="{StaticResource IconStats}" />
                        </Button>
                        <Button Classes="iconButton" Click="MoveItem_Click" ToolTip.Tip="Move to Folder">
                            <Path Classes="icon" Data="{StaticResource IconFolder}" />
                        </Button>
                        <Button Classes="iconButton" Click="DeleteDeck_Click" ToolTip.Tip="Delete Set">
                            <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                        </Button>
                    </StackPanel>
                </controls:LibraryCard.Actions>

                <StackPanel>
                    <TextBlock Classes="cardHint" Text="Click to review" FontSize="14" IsVisible="{Binding ShowReviewHint}" />
                    <TextBlock Classes="cardHint" Text="{Binding FolderPath, StringFormat='in {0}'}" IsVisible="{Binding ShowLocationHint}" />
                    <TextBlock Classes="cardHint" Text="Selected" FontSize="14" Foreground="{DynamicResource GradientStart}"
                        IsVisible="{Binding IsSelectedForMultiReview}" />
                </StackPanel>
            </controls:LibraryCard>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:Note}">
            <controls:LibraryCard Title="{Binding Name}"
                PointerPressed="Card_Click" KeyDown="Card_KeyDown">
                <controls:LibraryCard.Badge>
                    <TextBlock Text="Note" FontSize="12" FontWeight="Bold"
                        VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                </controls:LibraryCard.Badge>
                <controls:LibraryCard.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="iconButton" Click="RenameNote_Click" ToolTip.Tip="Rename Note">
                            <Path Classes="icon" Data="{StaticResource IconEdit}" />
                        </Button>
                        <Button Classes="iconButton" Click="NoteStats_Click" ToolTip.Tip="View Note Stats">
                            <Path Classes="icon" Data="{StaticResource IconStats}" />
                        </Button>
                        <Button Classes="iconButton" Click="MoveItem_Click" ToolTip.Tip="Move to Folder">
                            <Path Classes="icon" Data="{StaticResource IconFolder}" />
                        </Button>
                        <Button Classes="iconButton" Click="DeleteNote_Click" ToolTip.Tip="Delete Note">
                            <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                        </Button>
                    </StackPanel>
                </controls:LibraryCard.Actions>

                <StackPanel>
                    <TextBlock Classes="cardHint" Text="{Binding Summary}" IsVisible="{Binding !HasFolderPath}" />
                    <TextBlock Classes="cardHint" Text="{Binding FolderPath, StringFormat='in {0}'}" IsVisible="{Binding HasFolderPath}" />
                </StackPanel>
            </controls:LibraryCard>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>

        <Grid IsVisible="{Binding !IsGraphView}" RowDefinitions="86, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24, 16, 24, 0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                VerticalAlignment="Center">
                <TextBlock Text="Revi Flash" FontSize="30" FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}" />
                <Border Background="{DynamicResource BadgeBackground}" CornerRadius="13"
                    Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding StreakText}" FontSize="13"
                            FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Account and version, so it's always clear whether you're signed in. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                <TextBlock Text="{Binding AccountText}" FontSize="13" FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                    MaxWidth="260" TextTrimming="CharacterEllipsis" />
                <Button Classes="secondary" Content="Sign In" Click="SignIn_Click" IsVisible="{Binding !IsSignedIn}"
                    Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static utilities:TextUtility.VersionText}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="HelpButton_Click" Background="Transparent"
                    CornerRadius="18" Width="56" Height="56" Cursor="Hand"
                    ToolTip.Tip="Help: formatting guide and keyboard shortcuts">
                    <Path Classes="icon large" Data="{StaticResource IconHelp}" />
                </Button>
                <Button Click="SettingsButton_Click" Background="Transparent"
                    CornerRadius="18" Width="56" Height="56" Cursor="Hand"
                    ToolTip.Tip="Settings">
                    <Path Classes="icon large" Data="{StaticResource IconSettings}" />
                </Button>
            </StackPanel>
        </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*, 290" Margin="24, 12, 24, 0">

            <!-- Code-behind sets "compact" when the column is too narrow for the full labels. -->
            <Grid Grid.Column="0" x:Name="LibraryColumn" RowDefinitions="Auto, Auto, *" Margin="0, 0, 24, 0">
                <Grid.Styles>
                    <Style Selector="Grid#LibraryColumn TextBlock.short">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                    <Style Selector="Grid#LibraryColumn.compact TextBlock.short">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                    <Style Selector="Grid#LibraryColumn.compact TextBlock.long">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Grid.Styles>

                <Grid Grid.Row="0" x:Name="SearchRow" ColumnDefinitions="*, Auto, Auto" Margin="0, 0, 0, 14">
                    <Grid.Styles>
                        <Style Selector="Grid#SearchRow > :is(Control)">
                            <Setter Property="Height" Value="36" />
                        </Style>
                        <Style Selector="ComboBox#SortBox">
                            <Setter Property="Width" Value="200" />
                        </Style>
                        <Style Selector="Grid#LibraryColumn.compact ComboBox#SortBox">
                            <Setter Property="Width" Value="140" />
                        </Style>
                    </Grid.Styles>

                    <TextBox Grid.Column="0"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Watermark="{Binding SearchWatermark}"
                        Classes="input" VerticalContentAlignment="Center"
                        Padding="10, 0" Margin="0, 0, 12, 0" />

                    <ComboBox Grid.Column="1" x:Name="SortBox"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption}"
                        VerticalContentAlignment="Center"
                        CornerRadius="8" Margin="0,0,12,0"
                        Background="{DynamicResource CardBackground}" />

                    <Button Grid.Column="2" Classes="secondary"
                        Padding="14, 0" FontSize="14" FontWeight="Bold"
                        ToolTip.Tip="Create a set, note, folder or group here">
                        <TextBlock Text="+ New" VerticalAlignment="Center" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Flashcard Set" Click="CreateDeck_Click" />
                                <MenuItem Header="Note" Click="CreateNote_Click" />
                                <MenuItem Header="Folder" Click="CreateFolder_Click" />
                                <MenuItem Header="Study Group" Click="CreateGroup_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <controls:BreadcrumbBar Grid.Row="1" Margin="0,0,0,14"
                    Breadcrumbs="{Binding Breadcrumbs}"
                    IsVisible="{Binding IsInFolder}"
                    UpRequested="Breadcrumbs_UpRequested"
                    CrumbRequested="Breadcrumbs_CrumbRequested" />

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Margin="0,0,-16,0"
                        Padding="0,0,16,0">
                        <ItemsControl ItemsSource="{Binding DashboardItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyStateText}"
                        IsVisible="{Binding HasNoItems}"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        MaxWidth="420"
                        Margin="0,0,0,80" />

                    <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <ToggleButton
                                IsChecked="{Binding ShowFolders, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Folders" />
                                    <TextBlock Classes="short" Text="Folders" />
                                </Panel>
                            </ToggleButton>

                            <ToggleButton
                                IsChecked="{Binding ShowGroups, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Groups" />
                                    <TextBlock Classes="short" Text="Groups" />
                                </Panel>
                            </ToggleButton>

                            <ToggleButton
                                IsChecked="{Binding ShowSets, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Sets" />
                                    <TextBlock Classes="short" Text="Sets" />
                                </Panel>
                            </ToggleButton>

                            <ToggleButton
                                IsChecked="{Binding ShowNotes, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Notes" />
                                    <TextBlock Classes="short" Text="Notes" />
                                </Panel>
                            </ToggleButton>

                            <Button Classes="secondary" Click="MultiSelectDecks_Click"
                                Content="{Binding ReviewSelectionButtonText}"
                                Padding="12, 8" FontSize="14" />

                            <Button Click="OpenOnlineImport_Click"
                                Classes="secondary" Padding="12, 8"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Import: download community decks">
                                <Path Classes="icon" Data="{StaticResource IconDownload}" />
                            </Button>

                            <Button Click="OpenOnlineExport_Click"
                                Classes="secondary" Padding="12, 8"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Export: upload and manage your decks">
                                <Path Classes="icon" Data="{StaticResource IconUpload}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Column="1" Classes="card" Margin="0,0,0,24">
                <!-- Scrolls when the window is too short for every tile, such as after F11. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Panel>
                        <TextBlock Classes="sectionTitle" Text="Overall Stats" IsVisible="{Binding !IsViewingStats}" />
                        <TextBlock Classes="sectionTitle" Text="{Binding SelectedDeckForStats.Name, StringFormat='{}{0} Stats'}" IsVisible="{Binding IsViewingDeckStats}" />
                        <TextBlock Classes="sectionTitle" Text="{Binding SelectedGroupForStats.Name, StringFormat='{}{0} Stats'}" IsVisible="{Binding IsViewingGroupStats}" />
                        <TextBlock Classes="sectionTitle" Text="{Binding SelectedNoteForStats.Name, StringFormat='{}{0} Stats'}" IsVisible="{Binding IsViewingNoteStats}" />
                    </Panel>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0" Classes="timePeriod"
                            ItemsSource="{Binding TimePeriods}" SelectedItem="{Binding SelectedTimePeriod}" />
                        <Button Grid.Column="1" Classes="exit" Content="Exit" Click="CloseDecKStats_Click"
                            IsVisible="{Binding IsViewingStats}" />
                    </Grid>

                    <HeaderedContentControl Classes="statTile" Header="Total Questions" Content="{Binding TotalQuestions}" IsVisible="{Binding ShowCardStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Total Correct" Content="{Binding TotalCorrect}" IsVisible="{Binding ShowCardStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Accuracy Rate" Content="{Binding PercentageText}" IsVisible="{Binding ShowCardStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Grade" Content="{Binding Grade}" IsVisible="{Binding ShowCardStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Total Time" Content="{Binding TotalTimeFormatted}" />
                    <!-- Overall only: the total split into flashcards and notes. -->
                    <HeaderedContentControl Classes="statTile" Header="Flashcard Time" Content="{Binding FlashcardTimeFormatted}" IsVisible="{Binding ShowTimeSplit}" />
                    <HeaderedContentControl Classes="statTile" Header="Notes Time" Content="{Binding NoteTimeFormatted}" IsVisible="{Binding ShowTimeSplit}" />
                    <HeaderedContentControl Classes="statTile" Header="Last Studied" Content="{Binding NoteLastStudiedText}" IsVisible="{Binding IsViewingNoteStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Words" Content="{Binding NoteWordsText}" IsVisible="{Binding IsViewingNoteStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Headings" Content="{Binding NoteHeadingsText}" IsVisible="{Binding IsViewingNoteStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Best Answer Streak" Content="{Binding BestAnswerStreakText}" IsVisible="{Binding IsViewingCardStats}" />
                    <HeaderedContentControl Classes="statTile" Header="Best Ever Streak" Content="{Binding BestEverStreakText}" IsVisible="{Binding !IsViewingStats}" />

                    <Button Classes="secondary" Click="GraphStats_Click"
                        Content="Graph View"
                        CornerRadius="10" Padding="14, 10" FontSize="14" />
                </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsGraphView}" RowDefinitions="Auto, *" Margin="24, 16, 24, 24">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0, 0, 0, 16"
                VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding GraphViewTitle}" FontSize="30" FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding GraphViewSubtitle}" FontSize="13"
                        Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <ComboBox Grid.Column="1" Classes="timePeriod" Width="240" VerticalAlignment="Center"
                    ItemsSource="{Binding TimePeriods}" SelectedItem="{Binding SelectedTimePeriod}" />

                <Button Grid.Column="2" Classes="exit" Content="Exit" Click="ExitGraphView_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <!-- One row of tiles; hidden ones (card stats for a note, the time split outside overall) take no space. -->
                    <UniformGrid Rows="1" Margin="-7,0">
                        <HeaderedContentControl Classes="graphTile" Header="Total Questions" Content="{Binding TotalQuestions}" IsVisible="{Binding ShowCardStats}" />
                        <HeaderedContentControl Classes="graphTile" Header="Accuracy" Content="{Binding PercentageText}" IsVisible="{Binding ShowCardStats}" />
                        <HeaderedContentControl Classes="graphTile" Header="Total Time" Content="{Binding TotalTimeFormatted}" />
                        <HeaderedContentControl Classes="graphTile" Header="Flashcards" Content="{Binding FlashcardTimeFormatted}" IsVisible="{Binding ShowTimeSplit}" />
                        <HeaderedContentControl Classes="graphTile" Header="Notes" Content="{Binding NoteTimeFormatted}" IsVisible="{Binding ShowTimeSplit}" />
                        <HeaderedContentControl Classes="graphTile" Header="Grade" Content="{Binding Grade}" IsVisible="{Binding ShowCardStats}" />
                    </UniformGrid>

                    <Border Classes="card" IsVisible="{Binding HasAttemptsData}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="sectionTitle" Text="Attempts Chart" />
                                    <TextBlock Classes="caption" Text="Green shows correct answers, red shows incorrect answers." />
                                </StackPanel>

                                <ComboBox Grid.Column="1" VerticalAlignment="Top"
                                    ItemsSource="{Binding GraphGroupingOptions}"
                                    SelectedItem="{Binding SelectedAttemptsGrouping}"
                                    CornerRadius="6" Height="32"
                                    Padding="10, 4" FontSize="12" Width="100"
                                    Background="{DynamicResource StatTileBackground}"
                                    Foreground="{DynamicResource TextPrimary}">
                                </ComboBox>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AttemptsGraphPoints}" Margin="0,0,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GraphStatPointViewModel">
                                            <StackPanel Width="88" Spacing="8">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2" Height="34">
                                                    <TextBlock Text="{Binding Label}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />

                                                    <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="3">
                                                        <TextBlock Text="{Binding CorrectCountText}"
                                                            FontSize="10" FontWeight="SemiBold"
                                                            Foreground="{DynamicResource SuccessForeground}" />
                                                        <TextBlock Text="|"
                                                            FontSize="10"
                                                            Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding IncorrectCountText}"
                                                            FontSize="10" FontWeight="SemiBold"
                                                            Foreground="{DynamicResource DangerForeground}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Height="160" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border Width="28" Height="{Binding AttemptsBarHeight}"
                                                        CornerRadius="6" ClipToBounds="True" Background="#EEEF6B5B"
                                                        VerticalAlignment="Bottom"
                                                        IsVisible="{Binding HasAttempts}"
                                                        ToolTip.Tip="{Binding AttemptsTooltip}">
                                                        <Border Height="{Binding CorrectBarHeight}"
                                                            Background="{DynamicResource GradientStart}"
                                                            VerticalAlignment="Bottom" />
                                                    </Border>
                                                </Border>

                                                <TextBlock Text="{Binding AccuracyText}" FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding HasTimeData}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="sectionTitle" Text="Study Time Chart" />
                                    <TextBlock Classes="caption" Text="The bar height shows total time spent studying: blue is flashcards, purple is notes." />
                                </StackPanel>

                                <ComboBox Grid.Column="1" VerticalAlignment="Top"
                                    ItemsSource="{Binding GraphGroupingOptions}"
                                    SelectedItem="{Binding SelectedTimeGrouping}"
                                    CornerRadius="6" Height="32"
                                    Padding="10, 4" FontSize="12" Width="100"
                                    Background="{DynamicResource StatTileBackground}"
                                    Foreground="{DynamicResource TextPrimary}">
                                </ComboBox>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TimeGraphPoints}" Margin="0,0,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GraphStatPointViewModel">
                                            <StackPanel Width="88" Spacing="8">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2" Height="34">
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding TimeValueText}" FontSize="11"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>

                                                <!-- Flashcard time, with note time stacked at the bottom. -->
                                                <Border Height="160" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border Width="28" Height="{Binding TimeBarHeight}"
                                                        CornerRadius="6" ClipToBounds="True" Background="#FF4AA3FF"
                                                        VerticalAlignment="Bottom"
                                                        IsVisible="{Binding HasTime}"
                                                        ToolTip.Tip="{Binding TimeTooltip}">
                                                        <Border Height="{Binding NoteBarHeight}"
                                                            Background="#FFB57BFF"
                                                            VerticalAlignment="Bottom" />
                                                    </Border>
                                                </Border>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding !HasGraphData}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="No chart data yet" />
                            <TextBlock Classes="caption" Text="Review a set or group, or spend time in a note, to fill the graph view with daily activity." />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding HasTimeBreakdown}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="Where Your Time Went" />
                                <TextBlock Classes="caption" Text="The sets and notes you spent the most time on in this period." />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding TimeBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TimeSpentItem">
                                        <Grid ColumnDefinitions="240, 52, *, Auto" ColumnSpacing="12" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextPrimary}" />
                                            <Border Grid.Column="1" Background="{DynamicResource BadgeBackground}" CornerRadius="6" HorizontalAlignment="Left"
                                                Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                            <Border Grid.Column="2" Height="14" CornerRadius="5" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}" Background="{DynamicResource GradientStart}"
                                                VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="13"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextPrimary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Study calendar: the last year, a square per day shaded by time spent. -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="Study Calendar" />
                                <TextBlock Classes="caption" Text="{Binding HeatmapSummary}" />
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                                    <!-- Weekday labels, lined up with the Monday, Wednesday and Friday rows. -->
                                    <StackPanel Margin="0,18,0,0">
                                        <TextBlock Classes="heatDayLabel" Text="Mon" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                        <TextBlock Classes="heatDayLabel" Text="Wed" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                        <TextBlock Classes="heatDayLabel" Text="Fri" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding HeatmapWeeks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:HeatmapWeek">
                                                <StackPanel>
                                                    <!-- The Canvas lets a month label run past its narrow column without wrapping. -->
                                                    <Canvas Height="18" Width="15">
                                                        <TextBlock Text="{Binding MonthLabel}" FontSize="10"
                                                            Foreground="{DynamicResource TextSecondary}" />
                                                    </Canvas>
                                                    <ItemsControl ItemsSource="{Binding Days}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:HeatmapDay">
                                                                <Border Classes="heat"
                                                                    Classes.l1="{Binding IsLevel1}"
                                                                    Classes.l2="{Binding IsLevel2}"
                                                                    Classes.l3="{Binding IsLevel3}"
                                                                    Classes.l4="{Binding IsLevel4}"
                                                                    Classes.future="{Binding IsFuture}"
                                                                    ToolTip.Tip="{Binding Tooltip}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="Less" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <Border Classes="heat" />
                                <Border Classes="heat l1" />
                                <Border Classes="heat l2" />
                                <Border Classes="heat l3" />
                                <Border Classes="heat l4" />
                                <TextBlock Text="More (1 hour+)" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
