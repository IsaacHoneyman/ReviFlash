<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:models="using:ReviFlash.Models"
    xmlns:utilities="using:ReviFlash.Utilities"
    x:Class="ReviFlash.Views.DashboardView"
    x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="ToggleButton.dashboardToggle">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ToggleButton.dashboardToggle:checked">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type models:StudyGroup}">
            <Border Width="286" Height="145"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource GroupCardBorder}"
                BorderThickness="1.5" CornerRadius="20"
                Margin="0, 0, 16, 16" Padding="16" Cursor="Hand"
                Focusable="True"
                PointerPressed="GroupCard_Click"
                KeyDown="GroupCard_KeyDown">

                <Grid RowDefinitions="Auto, *">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *"
                        VerticalAlignment="Top">
                        <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GroupCardBorder}"
                            CornerRadius="8" Padding="9,5"
                            Height="28" MinHeight="28">
                            <StackPanel Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock Text="{Binding DeckCount}"
                                    FontSize="13" FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryButtonForeground}" />
                                <TextBlock Text="Decks" FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryButtonForeground}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="EditGroup_Click"
                                Background="#70FFFFFF" CornerRadius="8"
                                Padding="12,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand">
                                <TextBlock Text="✏️" FontSize="12"
                                    Foreground="{DynamicResource TextPrimary}" />
                            </Button>

                            <Button Click="GroupStats_Click"
                                Background="#7044AAFF" CornerRadius="8"
                                Padding="12,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="View Group Stats">
                                <TextBlock Text="📊" FontSize="12"
                                    Foreground="{DynamicResource TextPrimary}" />
                            </Button>

                            <Button Click="DeleteGroup_Click"
                                Background="#90FF4444" CornerRadius="8"
                                Padding="12,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Delete Group">
                                <TextBlock Text="🗑️" FontSize="12"
                                    Foreground="{DynamicResource TextPrimary}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Height="64" VerticalAlignment="Center" Padding="0,4,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Click to review group" FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            Margin="0, 6, 0, 0" />
                    </StackPanel>

                </Grid>

            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:FlashCardDeck}">
            <Border Width="286" Height="145"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1.5" CornerRadius="20"
                Margin="0, 0, 16, 16" Padding="16" Cursor="Hand"
                Focusable="True"
                PointerPressed="DeckCard_Click"
                KeyDown="DeckCard_KeyDown">

                <Grid RowDefinitions="Auto, *">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *"
                        VerticalAlignment="Top">
                        <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BadgeBackground}"
                            CornerRadius="8" Padding="9,5"
                            Height="28" MinHeight="28">
                            <StackPanel Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock Text="{Binding CardCount}"
                                    FontSize="13" FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Cards" FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="EditDeck_Click"
                                Background="#70FFFFFF" CornerRadius="8"
                                Padding="12,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand">
                                <TextBlock Text="✏️" FontSize="12"
                                    Foreground="{DynamicResource TextPrimary}" />
                            </Button>

                            <Button Click="DeckStats_Click"
                                Background="#7044AAFF" CornerRadius="8"
                                Padding="12,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="View Deck Stats">
                                <TextBlock Text="📊" FontSize="12"
                                    Foreground="{DynamicResource TextPrimary}" />
                            </Button>

                            <Button Click="DeleteDeck_Click"
                                Background="#90FF4444" CornerRadius="8"
                                Padding="12,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Delete Deck">
                                <TextBlock Text="🗑️" FontSize="12"
                                    Foreground="{DynamicResource TextPrimary}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Height="64" VerticalAlignment="Center" Padding="0,4,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Click to review" FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding !IsSelectedForMultiReview}"
                            Margin="0, 6, 0, 0" />
                        <TextBlock Text="Selected" FontSize="14"
                            Foreground="{DynamicResource GradientStart}"
                            IsVisible="{Binding IsSelectedForMultiReview}"
                            Margin="0, 6, 0, 0" />
                    </StackPanel>

                </Grid>

            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>

        <Grid IsVisible="{Binding !IsGraphView}" RowDefinitions="86, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24, 16, 24, 0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                VerticalAlignment="Center">
                <TextBlock Text="Revi Flash" FontSize="30" FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}" />
                <Border Background="{DynamicResource BadgeBackground}" CornerRadius="13"
                    Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding StreakText}" FontSize="13"
                            FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{x:Static utilities:TextUtility.VersionText}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />

            <Button Grid.Column="1" Click="SettingsButton_Click" Background="Transparent"
                CornerRadius="18" Width="56" Height="56" Cursor="Hand"
                VerticalAlignment="Center">
                <TextBlock Text="⚙️" FontSize="28" HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Button>
        </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*, 290" Margin="24, 12, 24, 0">

            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0, 0, 24, 0">

                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" Margin="0, 0, 0, 18">
                    <TextBox Grid.Column="0"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Watermark="Search flashcard sets..."
                        CornerRadius="8" Padding="10, 7" FontSize="14" Margin="0, 0, 12, 0"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextPrimary}" />

                    <ComboBox Grid.Column="1"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption}"
                        CornerRadius="8" Width="220" Margin="0,0,12,0"
                        Background="{DynamicResource CardBackground}" />

                    <Button Grid.Column="2"
                        Click="CreateGroup_Click"
                        Content="+ Create New Group"
                        CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource StatTileBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        Cursor="Hand" Margin="0,0,12,0" />

                    <Button Grid.Column="3"
                        Click="CreateDeck_Click"
                        Content="+ Create New Set"
                        CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="Bold"
                        Background="{DynamicResource StatTileBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        Cursor="Hand" />
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Margin="0,0,-16,0"
                        Padding="0,0,16,0">
                        <ItemsControl ItemsSource="{Binding DashboardItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <ToggleButton Content="Show Groups"
                                IsChecked="{Binding ShowGroups, Mode=TwoWay}"
                                Classes="dashboardToggle" />

                            <ToggleButton Content="Show Sets"
                                IsChecked="{Binding ShowSets, Mode=TwoWay}"
                                Classes="dashboardToggle" />


                            <Button Grid.Column="0" Click="MultiSelectDecks_Click"
                                Content="{Binding ReviewSelectionButtonText}"
                                CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="SemiBold"
                                Background="{DynamicResource StatTileBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                Cursor="Hand" />

                            <Button Click="ExportFlashCards_Click"
                                Content="{Binding ExportSelectionButtonText}"
                                CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="SemiBold"
                                Background="{DynamicResource StatTileBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                Cursor="Hand" />

                            <Button Click="ImportFlashCards_Click"
                                Content="Import"
                                CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="SemiBold"
                                Background="{DynamicResource StatTileBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                Cursor="Hand" />
                            <Button Click="OpenOnlineImport_Click"
                                Content="Online Import"
                                CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="SemiBold"
                                Background="{DynamicResource StatTileBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                Cursor="Hand" />

                            <Button Click="OpenOnlineExport_Click"
                                Content="Online Export"
                                CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="SemiBold"
                                Background="{DynamicResource StatTileBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Column="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1.5"
                CornerRadius="20"
                Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*">
                        <TextBlock Grid.Column="0" Text="Overall Stats" FontSize="18" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="{Binding !IsViewingStats}" />
                        <TextBlock Grid.Column="0" Text="{Binding SelectedDeckForStats.Name, StringFormat='{}{0} Stats'}" FontSize="18" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="{Binding IsViewingDeckStats}" />
                        <TextBlock Grid.Column="0" Text="{Binding SelectedGroupForStats.Name, StringFormat='{}{0} Stats'}" FontSize="18" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="{Binding IsViewingGroupStats}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding TimePeriods}"
                            SelectedItem="{Binding SelectedTimePeriod}"
                            CornerRadius="8"
                            Height="40"
                            Padding="12, 8" FontSize="14"
                            Background="{DynamicResource StatTileBackground}"
                            Foreground="{DynamicResource TextPrimary}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:DashboardViewModel+TimePeriodOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Click="CloseDecKStats_Click"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="10" Padding="16,10"
                            Height="40"
                            IsVisible="{Binding IsViewingStats}" VerticalAlignment="Center"
                            Cursor="Hand" Opacity="0.85">
                            <TextBlock Text="Exit" FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Questions"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalQuestions}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Correct"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalCorrect}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Accuracy Rate"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Grade"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding Grade}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Time"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalTimeFormatted}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Time per Card"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding AverageTimePerCardText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding IsViewingStats}">
                        <StackPanel>
                            <TextBlock Text="Best Answer Streak"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding BestAnswerStreakText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding !IsViewingStats}">
                        <StackPanel>
                            <TextBlock Text="Best Ever Streak"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding BestEverStreakText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Button Click="GraphStats_Click"
                        Content="Graph View"
                        CornerRadius="10" Padding="14, 10" FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource StatTileBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        Cursor="Hand" />
                </StackPanel>
            </Border>

        </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsGraphView}" RowDefinitions="Auto, *" Margin="24, 16, 24, 24">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0, 0, 0, 16"
                VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding GraphViewTitle}" FontSize="30" FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding GraphViewSubtitle}" FontSize="13"
                        Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <ComboBox Grid.Column="1"
                    ItemsSource="{Binding TimePeriods}"
                    SelectedItem="{Binding SelectedTimePeriod}"
                    CornerRadius="8"
                    Height="40"
                    Padding="12, 8" FontSize="14"
                    Width="240"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StatTileBackground}"
                    Foreground="{DynamicResource TextPrimary}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:DashboardViewModel+TimePeriodOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" Click="ExitGraphView_Click"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10" Padding="16,10"
                    Height="40"
                    VerticalAlignment="Center"
                    Cursor="Hand" Opacity="0.85">
                    <TextBlock Text="Exit" FontSize="12" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="14">
                        <Border Background="{DynamicResource StatTileBackground}" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Total Questions" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding TotalQuestions}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource StatTileBackground}" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Accuracy" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource StatTileBackground}" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Total Time" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding TotalTimeFormatted}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{DynamicResource StatTileBackground}" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Average Time" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding AverageTimePerCardText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{DynamicResource StatTileBackground}" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Grade" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Grade}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20"
                        IsVisible="{Binding HasGraphData}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Attempts Chart" FontSize="18" FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Green shows correct answers, red shows incorrect answers." FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1" VerticalAlignment="Top"
                                    ItemsSource="{Binding GraphGroupingOptions}"
                                    SelectedItem="{Binding SelectedAttemptsGrouping}"
                                    CornerRadius="6" Height="32"
                                    Padding="10, 4" FontSize="12" Width="100"
                                    Background="{DynamicResource StatTileBackground}"
                                    Foreground="{DynamicResource TextPrimary}">
                                </ComboBox>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AttemptsGraphPoints}" Margin="0,0,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GraphStatPointViewModel">
                                            <StackPanel Width="88" Spacing="8">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2" Height="34">
                                                    <TextBlock Text="{Binding Label}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />

                                                    <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="3">
                                                        <TextBlock Text="{Binding CorrectCountText}"
                                                            FontSize="10" FontWeight="SemiBold"
                                                            Foreground="{DynamicResource SuccessForeground}" />
                                                        <TextBlock Text="|"
                                                            FontSize="10"
                                                            Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding IncorrectCountText}"
                                                            FontSize="10" FontWeight="SemiBold"
                                                            Foreground="{DynamicResource DangerForeground}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Height="160" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border Width="28" Height="{Binding AttemptsBarHeight}"
                                                        CornerRadius="6" ClipToBounds="True" Background="#EEEF6B5B"
                                                        VerticalAlignment="Bottom"
                                                        IsVisible="{Binding HasAttempts}"
                                                        ToolTip.Tip="{Binding AttemptsTooltip}">
                                                        <Border Height="{Binding CorrectBarHeight}"
                                                            Background="{DynamicResource GradientStart}"
                                                            VerticalAlignment="Bottom" />
                                                    </Border>
                                                </Border>

                                                <TextBlock Text="{Binding AccuracyText}" FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20"
                        IsVisible="{Binding HasGraphData}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Study Time Chart" FontSize="18" FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="The bar height shows total time spent studying." FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1" VerticalAlignment="Top"
                                    ItemsSource="{Binding GraphGroupingOptions}"
                                    SelectedItem="{Binding SelectedTimeGrouping}"
                                    CornerRadius="6" Height="32"
                                    Padding="10, 4" FontSize="12" Width="100"
                                    Background="{DynamicResource StatTileBackground}"
                                    Foreground="{DynamicResource TextPrimary}">
                                </ComboBox>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TimeGraphPoints}" Margin="0,0,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GraphStatPointViewModel">
                                            <StackPanel Width="88" Spacing="8">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2" Height="34">
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding TimeValueText}" FontSize="11"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>

                                                <Border Height="160" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border Width="28" Height="{Binding TimeBarHeight}"
                                                        CornerRadius="6" Background="#FF4AA3FF"
                                                        VerticalAlignment="Bottom"
                                                        IsVisible="{Binding HasTime}"
                                                        ToolTip.Tip="{Binding TimeTooltip}" />
                                                </Border>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20"
                        IsVisible="{Binding !HasGraphData}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="No chart data yet" FontSize="18" FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Study a deck or group to populate the graph view with daily activity." FontSize="12"
                                Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
