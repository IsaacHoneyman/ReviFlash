<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:models="using:ReviFlash.Models"
    xmlns:utilities="using:ReviFlash.Utilities"
    x:Class="ReviFlash.Views.DashboardView"
    x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="ToggleButton.dashboardToggle">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ToggleButton.dashboardToggle:checked">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
        </Style>

        <!-- Graph view tiles, spaced by margin (the uniform grid they sit in has no spacing of its own). -->
        <Style Selector="Border.graphTile">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="7,0" />
        </Style>

        <!-- Study calendar squares: empty, then the theme colour stronger with more time studied. -->
        <Style Selector="Border.heat">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="1.5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Border.heat.l1">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Border.heat.l2">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.heat.l3">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Border.heat.l4">
            <Setter Property="Background" Value="{DynamicResource GradientStart}" />
        </Style>
        <Style Selector="Border.heat.future">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TextBlock.heatDayLabel">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type models:Folder}">
            <Border Width="286" Height="145"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource FolderCardBorder}"
                BorderThickness="1.5" CornerRadius="20"
                Margin="0, 0, 16, 16" Padding="16" Cursor="Hand"
                Focusable="True"
                PointerPressed="FolderCard_Click"
                KeyDown="FolderCard_KeyDown">

                <Grid RowDefinitions="Auto, *">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *"
                        VerticalAlignment="Top">
                        <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource FolderCardBorder}"
                            CornerRadius="8" Padding="9,5"
                            Height="28" MinHeight="28">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding ItemCount}"
                                    FontSize="13" FontWeight="Bold"
                                    Foreground="{DynamicResource FolderBadgeForeground}" />
                                <TextBlock Text="Items" FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource FolderBadgeForeground}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button Click="RenameFolder_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30" MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Rename Folder">
                                <Path Classes="icon" Data="{StaticResource IconEdit}" />
                            </Button>

                            <Button Click="MoveItem_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30" MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Move Folder">
                                <Path Classes="icon" Data="{StaticResource IconFolder}" />
                            </Button>

                            <Button Click="DeleteFolder_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30" MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Delete Folder (keeps its contents)">
                                <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Height="58" VerticalAlignment="Center" Padding="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Path Classes="icon medium" Data="{StaticResource IconFolder}" />
                                <TextBlock Text="{Binding Name}" FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ContentsSummary}" FontSize="13"
                            Foreground="{DynamicResource TextSecondary}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0, 4, 0, 0" />

                        <TextBlock Text="{Binding FolderPath, StringFormat='in {0}'}" FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding HasFolderPath}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0, 2, 0, 0" />
                    </StackPanel>

                </Grid>

            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:StudyGroup}">
            <Border Width="286" Height="145"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource GroupCardBorder}"
                BorderThickness="1.5" CornerRadius="20"
                Margin="0, 0, 16, 16" Padding="16" Cursor="Hand"
                Focusable="True"
                PointerPressed="GroupCard_Click"
                KeyDown="GroupCard_KeyDown">

                <Grid RowDefinitions="Auto, *">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *"
                        VerticalAlignment="Top">
                        <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GroupCardBorder}"
                            CornerRadius="8" Padding="9,5"
                            Height="28" MinHeight="28">
                            <StackPanel Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock Text="{Binding DeckCount}"
                                    FontSize="13" FontWeight="Bold"
                                    Foreground="{DynamicResource GroupBadgeForeground}" />
                                <TextBlock Text="Decks" FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource GroupBadgeForeground}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button Click="EditGroup_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Edit Group">
                                <Path Classes="icon" Data="{StaticResource IconEdit}" />
                            </Button>

                            <Button Click="GroupStats_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="View Group Stats">
                                <Path Classes="icon" Data="{StaticResource IconStats}" />
                            </Button>

                            <Button Click="MoveItem_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Move to Folder">
                                <Path Classes="icon" Data="{StaticResource IconFolder}" />
                            </Button>

                            <Button Click="DeleteGroup_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Delete Group">
                                <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Height="64" VerticalAlignment="Center" Padding="0,4,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Click to review group" FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding ShowReviewHint}"
                            Margin="0, 6, 0, 0" />
                        <TextBlock Text="{Binding FolderPath, StringFormat='in {0}'}" FontSize="13"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding ShowLocationHint}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0, 6, 0, 0" />
                    </StackPanel>

                </Grid>

            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:FlashCardDeck}">
            <Border Width="286" Height="145"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1.5" CornerRadius="20"
                Margin="0, 0, 16, 16" Padding="16" Cursor="Hand"
                Focusable="True"
                PointerPressed="DeckCard_Click"
                KeyDown="DeckCard_KeyDown">

                <Grid RowDefinitions="Auto, *">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *"
                        VerticalAlignment="Top">
                        <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BadgeBackground}"
                            CornerRadius="8" Padding="9,5"
                            Height="28" MinHeight="28">
                            <StackPanel Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock Text="{Binding CardCount}"
                                    FontSize="13" FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Cards" FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button Click="EditDeck_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Edit Set">
                                <Path Classes="icon" Data="{StaticResource IconEdit}" />
                            </Button>

                            <Button Click="DeckStats_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="View Set Stats">
                                <Path Classes="icon" Data="{StaticResource IconStats}" />
                            </Button>

                            <Button Click="MoveItem_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Move to Folder">
                                <Path Classes="icon" Data="{StaticResource IconFolder}" />
                            </Button>

                            <Button Click="DeleteDeck_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Delete Set">
                                <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Height="64" VerticalAlignment="Center" Padding="0,4,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Click to review" FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding ShowReviewHint}"
                            Margin="0, 6, 0, 0" />
                        <TextBlock Text="{Binding FolderPath, StringFormat='in {0}'}" FontSize="13"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding ShowLocationHint}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0, 6, 0, 0" />
                        <TextBlock Text="Selected" FontSize="14"
                            Foreground="{DynamicResource GradientStart}"
                            IsVisible="{Binding IsSelectedForMultiReview}"
                            Margin="0, 6, 0, 0" />
                    </StackPanel>

                </Grid>

            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:Note}">
            <Border Width="286" Height="145"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1.5" CornerRadius="20"
                Margin="0, 0, 16, 16" Padding="16" Cursor="Hand"
                Focusable="True"
                PointerPressed="NoteCard_Click"
                KeyDown="NoteCard_KeyDown">

                <Grid RowDefinitions="Auto, *">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *"
                        VerticalAlignment="Top">
                        <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BadgeBackground}"
                            CornerRadius="8" Padding="9,5"
                            Height="28" MinHeight="28">
                            <TextBlock Text="Note" FontSize="12" FontWeight="Bold"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextPrimary}" />
                        </Border>

                        <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button Click="RenameNote_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Rename Note">
                                <Path Classes="icon" Data="{StaticResource IconEdit}" />
                            </Button>

                            <Button Click="NoteStats_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="View Note Stats">
                                <Path Classes="icon" Data="{StaticResource IconStats}" />
                            </Button>

                            <Button Click="MoveItem_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Move to Folder">
                                <Path Classes="icon" Data="{StaticResource IconFolder}" />
                            </Button>

                            <Button Click="DeleteNote_Click"
                                Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                Padding="10,6" Height="30"
                                MinHeight="30"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="Delete Note">
                                <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Height="64" VerticalAlignment="Center" Padding="0,4,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Summary}" FontSize="13"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding !HasFolderPath}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0, 6, 0, 0" />
                        <TextBlock Text="{Binding FolderPath, StringFormat='in {0}'}" FontSize="13"
                            Foreground="{DynamicResource TextSecondary}"
                            IsVisible="{Binding HasFolderPath}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0, 6, 0, 0" />
                    </StackPanel>

                </Grid>

            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>

        <Grid IsVisible="{Binding !IsGraphView}" RowDefinitions="86, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24, 16, 24, 0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                VerticalAlignment="Center">
                <TextBlock Text="Revi Flash" FontSize="30" FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}" />
                <Border Background="{DynamicResource BadgeBackground}" CornerRadius="13"
                    Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding StreakText}" FontSize="13"
                            FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Account and version, so it's always clear whether you're signed in. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                <TextBlock Text="{Binding AccountText}" FontSize="13" FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                    MaxWidth="260" TextTrimming="CharacterEllipsis" />
                <Button Content="Sign In" Click="SignIn_Click" IsVisible="{Binding !IsSignedIn}"
                    Background="{DynamicResource StatTileBackground}" Foreground="{DynamicResource TextPrimary}"
                    CornerRadius="8" Padding="10,4" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                    VerticalAlignment="Center" />
                <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static utilities:TextUtility.VersionText}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="HelpButton_Click" Background="Transparent"
                    CornerRadius="18" Width="56" Height="56" Cursor="Hand"
                    ToolTip.Tip="Help: formatting guide and keyboard shortcuts">
                    <Path Classes="icon large" Data="{StaticResource IconHelp}" />
                </Button>
                <Button Click="SettingsButton_Click" Background="Transparent"
                    CornerRadius="18" Width="56" Height="56" Cursor="Hand"
                    ToolTip.Tip="Settings">
                    <Path Classes="icon large" Data="{StaticResource IconSettings}" />
                </Button>
            </StackPanel>
        </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*, 290" Margin="24, 12, 24, 0">

            <!-- "compact" is set from code-behind when the column is too narrow for the full labels, so the search
                 box keeps a usable width and the bottom bar stays inside its card in a small window. -->
            <Grid Grid.Column="0" x:Name="LibraryColumn" RowDefinitions="Auto, Auto, *" Margin="0, 0, 24, 0">
                <Grid.Styles>
                    <Style Selector="Grid#LibraryColumn TextBlock.short">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                    <Style Selector="Grid#LibraryColumn.compact TextBlock.short">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                    <Style Selector="Grid#LibraryColumn.compact TextBlock.long">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Grid.Styles>

                <Grid Grid.Row="0" x:Name="SearchRow" ColumnDefinitions="*, Auto, Auto" Margin="0, 0, 0, 14">
                    <Grid.Styles>
                        <Style Selector="Grid#SearchRow > :is(Control)">
                            <Setter Property="Height" Value="36" />
                        </Style>
                        <Style Selector="ComboBox#SortBox">
                            <Setter Property="Width" Value="200" />
                        </Style>
                        <Style Selector="Grid#LibraryColumn.compact ComboBox#SortBox">
                            <Setter Property="Width" Value="140" />
                        </Style>
                    </Grid.Styles>

                    <TextBox Grid.Column="0"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Watermark="{Binding SearchWatermark}"
                        VerticalContentAlignment="Center"
                        CornerRadius="8" Padding="10, 0" FontSize="14" Margin="0, 0, 12, 0"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextPrimary}" />

                    <ComboBox Grid.Column="1" x:Name="SortBox"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption}"
                        VerticalContentAlignment="Center"
                        CornerRadius="8" Margin="0,0,12,0"
                        Background="{DynamicResource CardBackground}" />

                    <Button Grid.Column="2"
                        CornerRadius="8" Padding="14, 0" FontSize="14" FontWeight="Bold"
                        Background="{DynamicResource StatTileBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        Cursor="Hand" ToolTip.Tip="Create a set, note, folder or group here">
                        <TextBlock Text="+ New" VerticalAlignment="Center" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Flashcard Set" Click="CreateDeck_Click" />
                                <MenuItem Header="Note" Click="CreateNote_Click" />
                                <MenuItem Header="Folder" Click="CreateFolder_Click" />
                                <MenuItem Header="Study Group" Click="CreateGroup_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Breadcrumb trail, shown only once you are inside a folder. -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,0,0,14"
                    IsVisible="{Binding IsInFolder}">

                    <Button Grid.Column="0"
                        Click="NavigateUp_Click"
                        Content="← Back"
                        CornerRadius="8" Padding="10, 6" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource StatTileBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        Cursor="Hand" Margin="0,0,12,0"
                        ToolTip.Tip="Back to the parent folder" />

                    <ScrollViewer Grid.Column="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Click="Breadcrumb_Click"
                                Content="Main Menu"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                CornerRadius="6" Padding="8,5" FontSize="13" FontWeight="SemiBold"
                                Cursor="Hand" />

                            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Folder}">
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="/" FontSize="13"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}" />
                                            <Button Click="Breadcrumb_Click"
                                                Content="{Binding Name}"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimary}"
                                                CornerRadius="6" Padding="8,5" FontSize="13" FontWeight="SemiBold"
                                                Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Margin="0,0,-16,0"
                        Padding="0,0,16,0">
                        <ItemsControl ItemsSource="{Binding DashboardItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyStateText}"
                        IsVisible="{Binding HasNoItems}"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        MaxWidth="420"
                        Margin="0,0,0,80" />

                    <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <ToggleButton
                                IsChecked="{Binding ShowFolders, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Folders" />
                                    <TextBlock Classes="short" Text="Folders" />
                                </Panel>
                            </ToggleButton>

                            <ToggleButton
                                IsChecked="{Binding ShowGroups, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Groups" />
                                    <TextBlock Classes="short" Text="Groups" />
                                </Panel>
                            </ToggleButton>

                            <ToggleButton
                                IsChecked="{Binding ShowSets, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Sets" />
                                    <TextBlock Classes="short" Text="Sets" />
                                </Panel>
                            </ToggleButton>

                            <ToggleButton
                                IsChecked="{Binding ShowNotes, Mode=TwoWay}"
                                Classes="dashboardToggle">
                                <Panel>
                                    <TextBlock Classes="long" Text="Show Notes" />
                                    <TextBlock Classes="short" Text="Notes" />
                                </Panel>
                            </ToggleButton>


                            <Button Grid.Column="0" Click="MultiSelectDecks_Click"
                                Content="{Binding ReviewSelectionButtonText}"
                                CornerRadius="8" Padding="12, 8" FontSize="14" FontWeight="SemiBold"
                                Background="{DynamicResource StatTileBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                Cursor="Hand" />

                            <Button Click="OpenOnlineImport_Click"
                                CornerRadius="8" Padding="12, 8"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource StatTileBackground}"
                                Cursor="Hand"
                                ToolTip.Tip="Import: download community decks">
                                <Path Classes="icon" Data="{StaticResource IconDownload}" />
                            </Button>

                            <Button Click="OpenOnlineExport_Click"
                                CornerRadius="8" Padding="12, 8"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource StatTileBackground}"
                                Cursor="Hand"
                                ToolTip.Tip="Export: upload and manage your decks">
                                <Path Classes="icon" Data="{StaticResource IconUpload}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Column="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1.5"
                CornerRadius="20"
                Padding="20"
                Margin="0,0,0,24">
                <!-- Scrolls when the window is too short for every tile, such as after F11. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*">
                        <TextBlock Grid.Column="0" Text="Overall Stats" FontSize="18" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="{Binding !IsViewingStats}" />
                        <TextBlock Grid.Column="0" Text="{Binding SelectedDeckForStats.Name, StringFormat='{}{0} Stats'}" FontSize="18" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="{Binding IsViewingDeckStats}" />
                        <TextBlock Grid.Column="0" Text="{Binding SelectedGroupForStats.Name, StringFormat='{}{0} Stats'}" FontSize="18" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="{Binding IsViewingGroupStats}" />
                        <TextBlock Grid.Column="0" Text="{Binding SelectedNoteForStats.Name, StringFormat='{}{0} Stats'}" FontSize="18" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="{Binding IsViewingNoteStats}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding TimePeriods}"
                            SelectedItem="{Binding SelectedTimePeriod}"
                            CornerRadius="8"
                            Height="40"
                            Padding="12, 8" FontSize="14"
                            Background="{DynamicResource StatTileBackground}"
                            Foreground="{DynamicResource TextPrimary}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:DashboardViewModel+TimePeriodOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Click="CloseDecKStats_Click"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="10" Padding="16,10"
                            Height="40"
                            IsVisible="{Binding IsViewingStats}" VerticalAlignment="Center"
                            Cursor="Hand" Opacity="0.85">
                            <TextBlock Text="Exit" FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding ShowCardStats}">
                        <StackPanel>
                            <TextBlock Text="Total Questions"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalQuestions}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding ShowCardStats}">
                        <StackPanel>
                            <TextBlock Text="Total Correct"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalCorrect}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding ShowCardStats}">
                        <StackPanel>
                            <TextBlock Text="Accuracy Rate"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding ShowCardStats}">
                        <StackPanel>
                            <TextBlock Text="Grade"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding Grade}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Time"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalTimeFormatted}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Overall only: the total split into flashcards and notes. -->
                    <Border IsVisible="{Binding ShowTimeSplit}" Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Flashcard Time"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding FlashcardTimeFormatted}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ShowTimeSplit}" Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Notes Time"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding NoteTimeFormatted}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- A note's own stats. -->
                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding IsViewingNoteStats}">
                        <StackPanel>
                            <TextBlock Text="Last Studied"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding NoteLastStudiedText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsViewingNoteStats}" Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Words"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding NoteWordsText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsViewingNoteStats}" Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16">
                        <StackPanel>
                            <TextBlock Text="Headings"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding NoteHeadingsText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding IsViewingCardStats}">
                        <StackPanel>
                            <TextBlock Text="Best Answer Streak"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding BestAnswerStreakText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource StatTileBackground}"
                        CornerRadius="10"
                        Padding="16"
                        IsVisible="{Binding !IsViewingStats}">
                        <StackPanel>
                            <TextBlock Text="Best Ever Streak"
                                Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding BestEverStreakText}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Button Click="GraphStats_Click"
                        Content="Graph View"
                        CornerRadius="10" Padding="14, 10" FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource StatTileBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        Cursor="Hand" />
                </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsGraphView}" RowDefinitions="Auto, *" Margin="24, 16, 24, 24">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0, 0, 0, 16"
                VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding GraphViewTitle}" FontSize="30" FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding GraphViewSubtitle}" FontSize="13"
                        Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <ComboBox Grid.Column="1"
                    ItemsSource="{Binding TimePeriods}"
                    SelectedItem="{Binding SelectedTimePeriod}"
                    CornerRadius="8"
                    Height="40"
                    Padding="12, 8" FontSize="14"
                    Width="240"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StatTileBackground}"
                    Foreground="{DynamicResource TextPrimary}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:DashboardViewModel+TimePeriodOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" Click="ExitGraphView_Click"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10" Padding="16,10"
                    Height="40"
                    VerticalAlignment="Center"
                    Cursor="Hand" Opacity="0.85">
                    <TextBlock Text="Exit" FontSize="12" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <!-- One row of tiles; hidden ones (card stats for a note, the time split outside overall) take no space. -->
                    <UniformGrid Rows="1" Margin="-7,0">
                        <Border Classes="graphTile" IsVisible="{Binding ShowCardStats}">
                            <StackPanel>
                                <TextBlock Text="Total Questions" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding TotalQuestions}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </Viewbox>
                            </StackPanel>
                        </Border>

                        <Border Classes="graphTile" IsVisible="{Binding ShowCardStats}">
                            <StackPanel>
                                <TextBlock Text="Accuracy" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </Viewbox>
                            </StackPanel>
                        </Border>

                        <Border Classes="graphTile">
                            <StackPanel>
                                <TextBlock Text="Total Time" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding TotalTimeFormatted}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </Viewbox>
                            </StackPanel>
                        </Border>

                        <Border Classes="graphTile" IsVisible="{Binding ShowTimeSplit}">
                            <StackPanel>
                                <TextBlock Text="Flashcards" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding FlashcardTimeFormatted}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </Viewbox>
                            </StackPanel>
                        </Border>

                        <Border Classes="graphTile" IsVisible="{Binding ShowTimeSplit}">
                            <StackPanel>
                                <TextBlock Text="Notes" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding NoteTimeFormatted}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </Viewbox>
                            </StackPanel>
                        </Border>

                        <Border Classes="graphTile" IsVisible="{Binding ShowCardStats}">
                            <StackPanel>
                                <TextBlock Text="Grade" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Grade}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20"
                        IsVisible="{Binding HasAttemptsData}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Attempts Chart" FontSize="18" FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Green shows correct answers, red shows incorrect answers." FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1" VerticalAlignment="Top"
                                    ItemsSource="{Binding GraphGroupingOptions}"
                                    SelectedItem="{Binding SelectedAttemptsGrouping}"
                                    CornerRadius="6" Height="32"
                                    Padding="10, 4" FontSize="12" Width="100"
                                    Background="{DynamicResource StatTileBackground}"
                                    Foreground="{DynamicResource TextPrimary}">
                                </ComboBox>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AttemptsGraphPoints}" Margin="0,0,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GraphStatPointViewModel">
                                            <StackPanel Width="88" Spacing="8">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2" Height="34">
                                                    <TextBlock Text="{Binding Label}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />

                                                    <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="3">
                                                        <TextBlock Text="{Binding CorrectCountText}"
                                                            FontSize="10" FontWeight="SemiBold"
                                                            Foreground="{DynamicResource SuccessForeground}" />
                                                        <TextBlock Text="|"
                                                            FontSize="10"
                                                            Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding IncorrectCountText}"
                                                            FontSize="10" FontWeight="SemiBold"
                                                            Foreground="{DynamicResource DangerForeground}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Height="160" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border Width="28" Height="{Binding AttemptsBarHeight}"
                                                        CornerRadius="6" ClipToBounds="True" Background="#EEEF6B5B"
                                                        VerticalAlignment="Bottom"
                                                        IsVisible="{Binding HasAttempts}"
                                                        ToolTip.Tip="{Binding AttemptsTooltip}">
                                                        <Border Height="{Binding CorrectBarHeight}"
                                                            Background="{DynamicResource GradientStart}"
                                                            VerticalAlignment="Bottom" />
                                                    </Border>
                                                </Border>

                                                <TextBlock Text="{Binding AccuracyText}" FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20"
                        IsVisible="{Binding HasTimeData}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Study Time Chart" FontSize="18" FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="The bar height shows total time spent studying: blue is flashcards, purple is notes." FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1" VerticalAlignment="Top"
                                    ItemsSource="{Binding GraphGroupingOptions}"
                                    SelectedItem="{Binding SelectedTimeGrouping}"
                                    CornerRadius="6" Height="32"
                                    Padding="10, 4" FontSize="12" Width="100"
                                    Background="{DynamicResource StatTileBackground}"
                                    Foreground="{DynamicResource TextPrimary}">
                                </ComboBox>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TimeGraphPoints}" Margin="0,0,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GraphStatPointViewModel">
                                            <StackPanel Width="88" Spacing="8">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2" Height="34">
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding TimeValueText}" FontSize="11"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>

                                                <!-- Flashcard time, with note time stacked at the bottom. -->
                                                <Border Height="160" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border Width="28" Height="{Binding TimeBarHeight}"
                                                        CornerRadius="6" ClipToBounds="True" Background="#FF4AA3FF"
                                                        VerticalAlignment="Bottom"
                                                        IsVisible="{Binding HasTime}"
                                                        ToolTip.Tip="{Binding TimeTooltip}">
                                                        <Border Height="{Binding NoteBarHeight}"
                                                            Background="#FFB57BFF"
                                                            VerticalAlignment="Bottom" />
                                                    </Border>
                                                </Border>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20"
                        IsVisible="{Binding !HasGraphData}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="No chart data yet" FontSize="18" FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Review a set or group, or spend time in a note, to fill the graph view with daily activity." FontSize="12"
                                Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>

                    <!-- Where your time went: the sets and notes with the most time in the chosen period (overall only). -->
                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20"
                        IsVisible="{Binding HasTimeBreakdown}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Where Your Time Went" FontSize="18" FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="The sets and notes you spent the most time on in this period." FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding TimeBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TimeSpentItem">
                                        <Grid ColumnDefinitions="240, 52, *, Auto" ColumnSpacing="12" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextPrimary}" />
                                            <Border Grid.Column="1" Background="{DynamicResource BadgeBackground}" CornerRadius="6" HorizontalAlignment="Left"
                                                Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                            <Border Grid.Column="2" Height="14" CornerRadius="5" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}" Background="{DynamicResource GradientStart}"
                                                VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="13"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextPrimary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Study calendar: the last year, a square per day shaded by time spent. -->
                    <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Study Calendar" FontSize="18" FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding HeatmapSummary}" FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                                    <!-- Weekday labels, lined up with the Monday, Wednesday and Friday rows. -->
                                    <StackPanel Margin="0,18,0,0">
                                        <TextBlock Classes="heatDayLabel" Text="Mon" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                        <TextBlock Classes="heatDayLabel" Text="Wed" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                        <TextBlock Classes="heatDayLabel" Text="Fri" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                        <TextBlock Classes="heatDayLabel" Text="" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding HeatmapWeeks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:HeatmapWeek">
                                                <StackPanel>
                                                    <!-- Wider than a column, so it overflows to the right instead of wrapping. -->
                                                    <Canvas Height="18" Width="15">
                                                        <TextBlock Text="{Binding MonthLabel}" FontSize="10"
                                                            Foreground="{DynamicResource TextSecondary}" />
                                                    </Canvas>
                                                    <ItemsControl ItemsSource="{Binding Days}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:HeatmapDay">
                                                                <Border Classes="heat"
                                                                    Classes.l1="{Binding IsLevel1}"
                                                                    Classes.l2="{Binding IsLevel2}"
                                                                    Classes.l3="{Binding IsLevel3}"
                                                                    Classes.l4="{Binding IsLevel4}"
                                                                    Classes.future="{Binding IsFuture}"
                                                                    ToolTip.Tip="{Binding Tooltip}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="Less" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <Border Classes="heat" />
                                <Border Classes="heat l1" />
                                <Border Classes="heat l2" />
                                <Border Classes="heat l3" />
                                <Border Classes="heat l4" />
                                <TextBlock Text="More (1 hour+)" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
