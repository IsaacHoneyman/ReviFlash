<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    x:Class="ReviFlash.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    Title="Settings"
    Width="420" Height="720"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <!-- A labelled setting: the header on the left, its control on the right. -->
        <Style Selector="HeaderedContentControl.settingRow">
            <Setter Property="Template">
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid ColumnDefinitions="*, Auto">
                        <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}"
                            VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                        <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <ScrollViewer Margin="24,24,8,24"
        Padding="0,0,16,0"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <TextBlock Classes="title" Text="Settings" />

            <Border Classes="card compact">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Appearance" />

                    <HeaderedContentControl Classes="settingRow" Header="Application Theme">
                        <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}"
                            Width="180" CornerRadius="5" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Classes="settingRow" Header="Background Swirl" Margin="0,6,0,0">
                        <CheckBox IsChecked="{Binding ShowBackgroundSwirl}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Classes="settingRow" Header="LaTeX Font for Card Text">
                        <CheckBox IsChecked="{Binding UseLatexFontForCards}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Classes="settingRow" Header="Show LaTeX Previews for Additional Fields">
                        <CheckBox IsChecked="{Binding ShowAdditionalFieldLatexPreviews}" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <Border Classes="card compact">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Review" />

                    <HeaderedContentControl Classes="settingRow" Header="Show Timer">
                        <CheckBox IsChecked="{Binding ShowTimer}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Classes="settingRow" Header="Show Progress Meter">
                        <CheckBox IsChecked="{Binding ShowProgress}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Classes="settingRow" Header="Show Skip Button">
                        <CheckBox IsChecked="{Binding ShowSkipButton}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Classes="settingRow" Header="Show Retry Later Button">
                        <CheckBox IsChecked="{Binding ShowRetryLaterButton}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Classes="settingRow" Header="Show Answer Streak">
                        <CheckBox IsChecked="{Binding ShowAnswerStreakInReview}" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <Border Classes="card compact">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Backup and Import" />

                    <TextBlock Classes="note"
                        Text="Create a backup zip or restore the app from an existing backup file." />

                    <HeaderedContentControl Classes="settingRow" Header="Include flashcard stats in backup">
                        <CheckBox x:Name="IncludeStatsInBackupCheckBox" IsChecked="True" />
                    </HeaderedContentControl>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button Grid.Column="0" Classes="wide secondary" Content="Create Backup" Click="CreateBackup_Click" />
                        <Button Grid.Column="1" Classes="wide secondary" Content="Restore Backup" Click="RestoreBackup_Click" />
                    </Grid>

                    <TextBlock x:Name="BackupStatusText" Classes="note" IsVisible="False" />

                    <Rectangle Height="1" Margin="0,6" Fill="{DynamicResource CardBorder}" />

                    <TextBlock Classes="heading" Text="Import from Anki" FontSize="13" />

                    <TextBlock Classes="note"
                        Text="Add the decks from an Anki .apkg file. Text, formatting, LaTeX, cloze, type-in and reversed cards all come across, and sub-decks become folders. Images and sounds aren't supported yet: cards with images are marked [image]." />

                    <Button x:Name="AnkiImportButton" Classes="wide secondary" Content="Import Anki Deck" Click="ImportAnki_Click" />

                    <TextBlock x:Name="AnkiImportStatusText" Classes="note" IsVisible="False" />
                </StackPanel>
            </Border>

            <Border Classes="card compact">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Updates" />

                    <HeaderedContentControl Classes="settingRow" Header="Check for updates on startup">
                        <CheckBox IsChecked="{Binding CheckForUpdatesOnStartup}" />
                    </HeaderedContentControl>

                    <Button Classes="wide secondary" Content="Check for Updates Now" Click="CheckForUpdates_Click" />

                    <TextBlock x:Name="UpdateStatusText" Classes="note" IsVisible="False" />
                </StackPanel>
            </Border>

            <Border Classes="card compact">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Account" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding AccountText}"
                            VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                            Foreground="{DynamicResource TextPrimary}" />
                        <Button Grid.Column="1" Classes="secondary" Content="Sign Out" Click="SignOut_Click"
                            IsVisible="{Binding IsSignedIn}" Padding="12,6" />
                        <Button Grid.Column="1" Classes="secondary" Content="Sign In" Click="SignIn_Click"
                            IsVisible="{Binding !IsSignedIn}" Padding="12,6" />
                    </Grid>

                    <Button Classes="wide secondary" Content="Change Username" Click="ChangeUsername_Click"
                        IsVisible="{Binding IsSignedIn}" Padding="12,8" />

                    <TextBlock Classes="caption" Text="Sign in to share decks, keep private copies, and download community decks."
                        IsVisible="{Binding !IsSignedIn}" TextWrapping="Wrap" />

                    <TextBlock x:Name="AccountStatusText" Classes="note" IsVisible="False" />
                </StackPanel>
            </Border>

            <Border Classes="card compact" Background="{DynamicResource SurfaceOverlayBackground}"
                BorderBrush="{DynamicResource DangerForeground}" BorderThickness="1.5">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Danger Zone" FontSize="16"
                        Foreground="{DynamicResource DangerForeground}" />

                    <TextBlock Classes="note" Foreground="{DynamicResource TextPrimary}"
                        Text="Delete flashcard stats, for every deck or just one. This cannot be undone." />

                    <Button Classes="wide danger" Content="Delete All Flashcard Stats" Click="DeleteAllStats_Click" />
                    <Button Classes="wide danger" Content="Delete Flashcard Deck Stats" Click="OpenDeleteDeckStats_Click" />

                    <TextBlock x:Name="DeleteStatsStatusText" Classes="note" IsVisible="False" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>