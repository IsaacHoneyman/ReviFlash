<controls:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ReviFlash.Views.Controls"
        x:Class="ReviFlash.Views.UpdateProgressWindow"
        Title="Updating ReviFlash"
        Width="450" Height="200">

    <Border Classes="dialogShell">
        <Grid RowDefinitions="*, Auto, Auto">
            <TextBlock x:Name="MessageText"
                       Text="Downloading update... 0%"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <ProgressBar x:Name="DownloadProgress" Grid.Row="1"
                         Minimum="0" Maximum="100" Value="0" Height="8" CornerRadius="4"
                         Foreground="{DynamicResource GradientStart}" Margin="0,16,0,0"/>

            <Button x:Name="CloseButton" Grid.Row="2" Classes="dialog secondary" Click="Close_Click" Content="Close" IsVisible="False"
                    HorizontalAlignment="Center" Margin="0,16,0,0" />
        </Grid>
    </Border>
</controls:DialogWindow>
