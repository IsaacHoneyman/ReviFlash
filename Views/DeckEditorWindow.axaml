<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:models="using:ReviFlash.Models"
    xmlns:views="using:ReviFlash.Views"
    xmlns:converters="using:ReviFlash.Converters"
    x:Class="ReviFlash.Views.DeckEditorWindow"
    x:DataType="vm:DeckEditorViewModel"
    Title="Deck Editor"
    Width="1000" Height="700"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <converters:BoolToOptionMarkerConverter x:Key="BoolToOptionMarkerConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="4,4,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>
        <Style Selector="TextBox.multiline">
            <Setter Property="Height" Value="60" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- LaTeX preview under a field: "small" for options, pairs and labels -->
        <Style Selector="Border.preview">
            <Setter Property="Background" Value="#15000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinHeight" Value="60" />
        </Style>
        <Style Selector="Border.preview.small">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button.addRow">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#7044AAFF" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
        </Style>
        <Style Selector="Button.removeRow">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#60FF4444" />
        </Style>
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="#15000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <!-- Not focusable, so clicking keeps the cursor in the field being formatted -->
        <Style Selector="Button.format">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.format TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Rectangle.separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Fill" Value="{DynamicResource CardBorder}" />
        </Style>
        <Style Selector="views|MathText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *" Margin="32">

        <TextBox Grid.Row="0"
            Text="{Binding DeckName, Mode=TwoWay}"
            FontSize="32" FontWeight="Bold"
            Background="Transparent" BorderThickness="0,0,0,2"
            Foreground="{DynamicResource TextPrimary}"
            Margin="0,0,0,24" />

        <Grid Grid.Row="1" ColumnDefinitions="1*, 1*">

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                x:Name="EditorScroll"
                Margin="0,0,8,0"
                Padding="0,0,16,0">
                <Grid Width="{Binding #EditorScroll.Bounds.Width}">
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="15" Padding="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                        <StackPanel Spacing="12" x:Name="EditorPanel">
                        <TextBlock Text="Add New Card" FontSize="20" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}" />

                        <ComboBox ItemsSource="{Binding AvailableCardTypes}"
                            SelectedItem="{Binding SelectedCardType}"
                            HorizontalAlignment="Stretch"
                            CornerRadius="8" />

                        <!-- Formatting toolbar: acts on the card field last clicked into -->
                        <Border Classes="toolbar">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="format" Click="Bold_Click" ToolTip.Tip="Bold: \B{...}  (Ctrl+B)">
                                    <TextBlock Text="B" FontWeight="Bold" />
                                </Button>
                                <Button Classes="format" Click="Italic_Click" ToolTip.Tip="Italic: \I{...}  (Ctrl+I)">
                                    <!-- An icon, as the app's Inter has no italic face: a slanted plain "I" reads as "/" -->
                                    <Path Classes="icon" Data="{StaticResource IconItalic}" Width="9" StrokeThickness="1.7" />
                                </Button>
                                <Button Classes="format" Click="Underline_Click" ToolTip.Tip="Underline: \U{...}  (Ctrl+U)">
                                    <TextBlock Text="U" TextDecorations="Underline" />
                                </Button>
                                <Rectangle Classes="separator" />
                                <Button Classes="format" Click="Heading1_Click" ToolTip.Tip="Heading: \H1{...}  (Ctrl+1)">
                                    <TextBlock Text="H1" FontWeight="Bold" />
                                </Button>
                                <Button Classes="format" Click="Heading2_Click" ToolTip.Tip="Subheading: \H2{...}  (Ctrl+2)">
                                    <TextBlock Text="H2" FontWeight="Bold" />
                                </Button>
                                <Button Classes="format" Click="Heading3_Click" ToolTip.Tip="Small heading: \H3{...}  (Ctrl+3)">
                                    <TextBlock Text="H3" FontWeight="Bold" />
                                </Button>
                                <Rectangle Classes="separator" />
                                <Button Classes="format" Click="InlineMath_Click" ToolTip.Tip="Maths in the line: $...$  (Ctrl+M)">
                                    <TextBlock Text="Maths" />
                                </Button>
                                <Button Classes="format" Click="DisplayMath_Click" ToolTip.Tip="Maths on its own line: $$...$$  (Ctrl+Shift+M)">
                                    <TextBlock Text="Maths Block" />
                                </Button>
                                <Button Classes="format" Click="Blank_Click" IsVisible="{Binding IsClozeCardType}"
                                    ToolTip.Tip="Cloze blank: \C{...}  (Ctrl+Shift+C)">
                                    <TextBlock Text="Blank" />
                                </Button>
                                <Rectangle Classes="separator" />
                                <Button Classes="format" Click="Help_Click" ToolTip.Tip="Formatting and LaTeX guide">
                                    <TextBlock Text="?" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="fieldLabel" Text="{Binding FrontLabel}" />
                        <TextBox Classes="field multiline" x:Name="FrontBox" Text="{Binding NewFront, Mode=TwoWay}" />
                        <Border Classes="preview">
                            <views:MathText Text="{Binding NewFront}" ShowErrors="True" />
                        </Border>

                        <TextBlock Classes="fieldLabel" Text="{Binding BackLabel}" />
                        <TextBox Classes="field multiline" Text="{Binding NewBack, Mode=TwoWay}" />
                        <Border Classes="preview">
                            <views:MathText Text="{Binding NewBack}" ShowErrors="True" />
                        </Border>

                        <CheckBox IsVisible="{Binding IsFlipCardType}" IsChecked="{Binding NewIsReversible, Mode=TwoWay}"
                            Content="Also ask in reverse (back → front)"
                            ToolTip.Tip="Reviews ask this card both ways, as two separate questions." />

                        <StackPanel Spacing="6" IsVisible="{Binding IsClozeCardType}">
                            <CheckBox IsChecked="{Binding NewClozeTypeAnswer, Mode=TwoWay}"
                                Content="Answer by typing the hidden text" />
                            <TextBlock Classes="hint"
                                Text="Each \C{...} blank becomes its own question. Give blanks the same number, like \C1{...}, to hide them together." />
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsTypeCardType}">
                            <TextBlock Classes="fieldLabel" Text="Typed Answer (Accepted Input)" />
                            <TextBox Classes="field" Text="{Binding NewTypeAnswer, Mode=TwoWay}" Height="40"
                                Watermark="What the user must type" />
                            <Border Classes="preview small" IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewTypeAnswer}" ShowErrors="True" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsTrueFalseCardType}">
                            <TextBlock Classes="fieldLabel" Text="True/False labels" />

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="True:" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding NewTrueOptionText, Mode=TwoWay}"
                                    Watermark="Label for true option" />
                            </Grid>
                            <Border Classes="preview small" IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewTrueOptionText}" ShowErrors="True" />
                            </Border>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="False:" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding NewFalseOptionText, Mode=TwoWay}"
                                    Watermark="Label for false option" />
                            </Grid>
                            <Border Classes="preview small" IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewFalseOptionText}" ShowErrors="True" />
                            </Border>

                            <CheckBox IsChecked="{Binding NewTrueFalseAnswerIsTrue, Mode=TwoWay}"
                                Content="Correct answer is the True label" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsMultiChoiceCardType}">
                            <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Options (max 8)" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Classes="addRow" Click="AddOption_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconPlus}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Add Option" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MultiChoiceOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MultiChoiceOptionEditor">
                                        <StackPanel Spacing="4" Margin="0,4,0,4">
                                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,2">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCorrect, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Classes="field" Text="{Binding OptionText, Mode=TwoWay}"
                                                    Watermark="Option text" />
                                                <Button Grid.Column="2" Classes="removeRow" Click="RemoveOption_Click" ToolTip.Tip="Remove option">
                                                    <Path Classes="icon" Width="12" Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <Border Classes="preview small"
                                                IsVisible="{Binding $parent[Window].DataContext.ShowAdditionalFieldLatexPreviews}">
                                                <views:MathText Text="{Binding OptionText}" ShowErrors="True" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="hint" Text="Tick each correct option. Users can select multiple answers during review." />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsMatchCardType}">
                            <TextBlock Classes="fieldLabel" Text="Match cards use fixed question text: Match The Cards" Margin="0" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Match pairs (max 8)" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Classes="addRow" Click="AddMatchPair_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconPlus}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Add Pair" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MatchPairs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchPairEditor">
                                        <StackPanel Spacing="4" Margin="0,4,0,4">
                                            <Grid ColumnDefinitions="*, Auto, *, Auto" Margin="0,0,0,2">
                                                <TextBox Grid.Column="0" Classes="field" Text="{Binding LeftText, Mode=TwoWay}" Watermark="Left text" />
                                                <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconLeftRight}" Margin="8,0"
                                                    Stroke="{DynamicResource TextSecondary}" />
                                                <TextBox Grid.Column="2" Classes="field" Text="{Binding RightText, Mode=TwoWay}" Watermark="Right text" />
                                                <Button Grid.Column="3" Classes="removeRow" Click="RemoveMatchPair_Click" ToolTip.Tip="Remove pair">
                                                    <Path Classes="icon" Width="12" Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="8" IsVisible="{Binding $parent[Window].DataContext.ShowAdditionalFieldLatexPreviews}">
                                                <Border Grid.Column="0" Classes="preview small">
                                                    <views:MathText Text="{Binding LeftText}" ShowErrors="True" />
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondary}" />

                                                <Border Grid.Column="2" Classes="preview small">
                                                    <views:MathText Text="{Binding RightText}" ShowErrors="True" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="hint" Text="In review, left and right sides are shuffled and the user matches them." />
                        </StackPanel>

                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF6666"
                            TextWrapping="Wrap" FontSize="12" IsVisible="{Binding HasValidationMessage}" />

                        <Button Click="AddCard_Click" Content="{Binding SaveButtonText}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Margin="0,10,0,0"
                            Background="{DynamicResource GradientStart}" Foreground="{DynamicResource PrimaryButtonForeground}"
                            FontWeight="Bold" Padding="12" CornerRadius="8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,0,-24,0"
                Padding="0,0,24,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Loading cards..."
                        FontSize="12" FontWeight="Bold"
                        Foreground="{DynamicResource TextSecondary}"
                        IsVisible="{Binding IsCardsLoading}" />

                    <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FlashCard">
                            <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="*, Auto">
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CardType}"
                                        FontSize="11" FontWeight="Bold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,8" />

                                    <StackPanel Grid.Column="0" Grid.RowSpan="2" Spacing="12" IsVisible="{Binding !IsMatchCard}">
                                        <views:MathText Text="{Binding Front}" />

                                        <Rectangle Height="1" Fill="{DynamicResource CardBorder}"
                                            Opacity="0.3" />

                                        <views:MathText Text="{Binding Back}" Foreground="{DynamicResource TextSecondary}" />

                                        <StackPanel Spacing="6" IsVisible="{Binding IsMultiChoiceCard}">
                                            <TextBlock Text="Options Preview" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextSecondary}" />
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                                HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding MultiChoiceOptionsPreview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:MultiChoicePreviewOption">
                                                            <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,6">
                                                                <TextBlock Grid.Column="0"
                                                                    Text="{Binding IsCorrect, Converter={StaticResource BoolToOptionMarkerConverter}}"
                                                                    FontSize="11" Foreground="#88CC88"
                                                                    VerticalAlignment="Top" Margin="0,0,8,0" />
                                                                <views:MathText Text="{Binding Text}" Grid.Column="1" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.RowSpan="2" Spacing="8" IsVisible="{Binding IsMatchCard}">
                                        <views:MathText Text="{Binding Front}" />

                                        <TextBlock Text="Match pairs preview" FontSize="12"
                                            Foreground="{DynamicResource TextSecondary}" />

                                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding MatchPairsPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MatchPreviewPair">
                                                        <Grid ColumnDefinitions="2*, Auto, *" Margin="0,0,0,8">
                                                            <views:MathText Text="{Binding LeftText}" Grid.Column="0" />

                                                            <TextBlock Grid.Column="1" Text="→" Margin="8,0"
                                                                Foreground="{DynamicResource TextSecondary}" />

                                                            <views:MathText Text="{Binding RightText}" Grid.Column="2" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="8" Margin="10,0,0,0">
                                        <Button Click="CopyCard_Click"
                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                            Padding="10,8"
                                            ToolTip.Tip="Duplicate Card">
                                            <Path Classes="icon editorAction" Data="{StaticResource IconCopy}" />
                                        </Button>

                                        <Button Click="EditCard_Click"
                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                            Padding="10,8"
                                            ToolTip.Tip="Edit Card">
                                            <Path Classes="icon editorAction" Data="{StaticResource IconEdit}" />
                                        </Button>

                                        <Button Click="DeleteCard_Click"
                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                            Padding="10,8"
                                            ToolTip.Tip="Delete Card">
                                            <Path Classes="icon editorAction danger" Data="{StaticResource IconDelete}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>