<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:models="using:ReviFlash.Models"
    xmlns:views="using:ReviFlash.Views"
    xmlns:converters="using:ReviFlash.Converters"
    x:Class="ReviFlash.Views.DeckEditorWindow"
    x:DataType="vm:DeckEditorViewModel"
    Title="Deck Editor"
    Width="1000" Height="700"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <converters:BoolToOptionMarkerConverter x:Key="BoolToOptionMarkerConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto, *" Margin="32">

        <TextBox Grid.Row="0"
            Text="{Binding DeckName, Mode=TwoWay}"
            FontSize="32" FontWeight="Bold"
            Background="Transparent" BorderThickness="0,0,0,2"
            Foreground="{DynamicResource TextPrimary}"
            Margin="0,0,0,24" />

        <Grid Grid.Row="1" ColumnDefinitions="1*, 1*">

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                x:Name="EditorScroll"
                Margin="0,0,8,0"
                Padding="0,0,16,0">
                <Grid Width="{Binding #EditorScroll.Bounds.Width}">
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="15" Padding="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                        <TextBlock Text="Add New Card" FontSize="20" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}" />

                        <ComboBox ItemsSource="{Binding AvailableCardTypes}"
                            SelectedItem="{Binding SelectedCardType}"
                            HorizontalAlignment="Stretch"
                            CornerRadius="8" />

                        <TextBlock Text="Front (Question)" FontSize="12"
                            Foreground="{DynamicResource TextSecondary}" Margin="4,4,0,0" />
                        <TextBox Text="{Binding NewFront, Mode=TwoWay}" Height="60"
                            AcceptsReturn="True" TextWrapping="Wrap"
                            Background="{DynamicResource AppBackground}" />

                        <Border Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="60">
                            <views:MathText Text="{Binding NewFront}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                        </Border>


                        <TextBlock Text="Back (Answer)" FontSize="12"
                            Foreground="{DynamicResource TextSecondary}" Margin="4,4,0,0" />
                        <TextBox Text="{Binding NewBack, Mode=TwoWay}" Height="60"
                            AcceptsReturn="True" TextWrapping="Wrap"
                            Background="{DynamicResource AppBackground}" />

                        <Border Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="60">
                            <views:MathText Text="{Binding NewBack}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                        </Border>

                        <StackPanel Spacing="6" IsVisible="{Binding IsTypeCardType}">
                            <TextBlock Text="Typed Answer (Accepted Input)" FontSize="12"
                                Foreground="{DynamicResource TextSecondary}" Margin="4,4,0,0" />
                            <TextBox Text="{Binding NewTypeAnswer, Mode=TwoWay}" Height="40"
                                Watermark="What the user must type"
                                Background="{DynamicResource AppBackground}" />

                            <Border Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="40"
                                IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewTypeAnswer}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsTrueFalseCardType}">
                            <TextBlock Text="True/False labels" FontSize="12"
                                Foreground="{DynamicResource TextSecondary}" Margin="4,4,0,0" />

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="True:" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <TextBox Grid.Column="1" Text="{Binding NewTrueOptionText, Mode=TwoWay}"
                                    Watermark="Label for true option"
                                    Background="{DynamicResource AppBackground}" />
                            </Grid>

                            <Border Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="46"
                                IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewTrueOptionText}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                            </Border>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="False:" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <TextBox Grid.Column="1" Text="{Binding NewFalseOptionText, Mode=TwoWay}"
                                    Watermark="Label for false option"
                                    Background="{DynamicResource AppBackground}" />
                            </Grid>

                            <Border Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="46"
                                IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewFalseOptionText}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                            </Border>

                            <CheckBox IsChecked="{Binding NewTrueFalseAnswerIsTrue, Mode=TwoWay}"
                                Content="Correct answer is the True label" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsMultiChoiceCardType}">
                            <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="Options (max 8)" FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Click="AddOption_Click"
                                    CornerRadius="8" Padding="10,6"
                                    Background="#7044AAFF" Foreground="{DynamicResource PrimaryButtonForeground}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconPlus}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Add Option" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MultiChoiceOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MultiChoiceOptionEditor">
                                        <StackPanel Spacing="4" Margin="0,4,0,4">
                                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,2">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCorrect, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Text="{Binding OptionText, Mode=TwoWay}"
                                                    Watermark="Option text"
                                                    Background="{DynamicResource AppBackground}" />
                                                <Button Grid.Column="2" Click="RemoveOption_Click"
                                                    CornerRadius="6" Padding="8,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="#60FF4444" ToolTip.Tip="Remove option">
                                                    <Path Classes="icon" Width="12" Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <Border Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="8" MinHeight="32"
                                                IsVisible="{Binding $parent[Window].DataContext.ShowAdditionalFieldLatexPreviews}">
                                                <views:MathText Text="{Binding OptionText}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Tick each correct option. Users can select multiple answers during review."
                                FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsMatchCardType}">
                            <TextBlock Text="Match cards use fixed question text: Match The Cards"
                                FontSize="12" Foreground="{DynamicResource TextSecondary}" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="Match pairs (max 8)" FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Click="AddMatchPair_Click"
                                    CornerRadius="8" Padding="10,6"
                                    Background="#7044AAFF" Foreground="{DynamicResource PrimaryButtonForeground}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconPlus}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Add Pair" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MatchPairs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchPairEditor">
                                        <StackPanel Spacing="4" Margin="0,4,0,4">
                                            <Grid ColumnDefinitions="*, Auto, *, Auto" Margin="0,0,0,2">
                                                <TextBox Grid.Column="0" Text="{Binding LeftText, Mode=TwoWay}"
                                                    Watermark="Left text" Background="{DynamicResource AppBackground}" />
                                                <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconLeftRight}" Margin="8,0"
                                                    Stroke="{DynamicResource TextSecondary}" />
                                                <TextBox Grid.Column="2" Text="{Binding RightText, Mode=TwoWay}"
                                                    Watermark="Right text" Background="{DynamicResource AppBackground}" />
                                                <Button Grid.Column="3" Click="RemoveMatchPair_Click"
                                                    CornerRadius="6" Padding="8,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="#60FF4444" ToolTip.Tip="Remove pair">
                                                    <Path Classes="icon" Width="12" Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="8" IsVisible="{Binding $parent[Window].DataContext.ShowAdditionalFieldLatexPreviews}">
                                                <Border Grid.Column="0" Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8" MinHeight="32">
                                                    <views:MathText Text="{Binding LeftText}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" Margin="0,0,0,0"
                                                    Foreground="{DynamicResource TextSecondary}" />

                                                <Border Grid.Column="2" Background="#15000000" BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8" MinHeight="32">
                                                    <views:MathText Text="{Binding RightText}" FontSize="14" Foreground="{DynamicResource TextPrimary}" ShowErrors="True" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="In review, left and right sides are shuffled and the user matches them."
                                FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF6666"
                            TextWrapping="Wrap" FontSize="12" IsVisible="{Binding HasValidationMessage}" />

                        <Button Click="AddCard_Click" Content="{Binding SaveButtonText}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Margin="0,10,0,0"
                            Background="{DynamicResource GradientStart}" Foreground="{DynamicResource PrimaryButtonForeground}"
                            FontWeight="Bold" Padding="12" CornerRadius="8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,0,-24,0"
                Padding="0,0,24,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Loading cards..."
                        FontSize="12" FontWeight="Bold"
                        Foreground="{DynamicResource TextSecondary}"
                        IsVisible="{Binding IsCardsLoading}" />

                    <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FlashCard">
                            <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="*, Auto">
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CardType}"
                                        FontSize="11" FontWeight="Bold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,8" />

                                    <StackPanel Grid.Column="0" Grid.RowSpan="2" Spacing="12" IsVisible="{Binding !IsMatchCard}">
                                        <views:MathText Text="{Binding Front}" FontSize="14" Foreground="{DynamicResource TextPrimary}" />

                                        <Rectangle Height="1" Fill="{DynamicResource CardBorder}"
                                            Opacity="0.3" />

                                        <views:MathText Text="{Binding Back}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />

                                        <StackPanel Spacing="6" IsVisible="{Binding IsMultiChoiceCard}">
                                            <TextBlock Text="Options Preview" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextSecondary}" />
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                                HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding MultiChoiceOptionsPreview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:MultiChoicePreviewOption">
                                                            <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,6">
                                                                <TextBlock Grid.Column="0"
                                                                    Text="{Binding IsCorrect, Converter={StaticResource BoolToOptionMarkerConverter}}"
                                                                    FontSize="11" Foreground="#88CC88"
                                                                    VerticalAlignment="Top" Margin="0,0,8,0" />
                                                                <views:MathText Text="{Binding Text}" Grid.Column="1" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.RowSpan="2" Spacing="8" IsVisible="{Binding IsMatchCard}">
                                        <views:MathText Text="{Binding Front}" FontSize="14" Foreground="{DynamicResource TextPrimary}" />

                                        <TextBlock Text="Match pairs preview" FontSize="12"
                                            Foreground="{DynamicResource TextSecondary}" />

                                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding MatchPairsPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MatchPreviewPair">
                                                        <Grid ColumnDefinitions="2*, Auto, *" Margin="0,0,0,8">
                                                            <views:MathText Text="{Binding LeftText}" Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextPrimary}" />

                                                            <TextBlock Grid.Column="1" Text="→" Margin="8,0"
                                                                Foreground="{DynamicResource TextSecondary}" />

                                                            <views:MathText Text="{Binding RightText}" Grid.Column="2" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="8" Margin="10,0,0,0">
                                        <Button Click="CopyCard_Click"
                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                            Padding="10,8"
                                            ToolTip.Tip="Duplicate Card">
                                            <Path Classes="icon editorAction" Data="{StaticResource IconCopy}" />
                                        </Button>

                                        <Button Click="EditCard_Click"
                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                            Padding="10,8"
                                            ToolTip.Tip="Edit Card">
                                            <Path Classes="icon editorAction" Data="{StaticResource IconEdit}" />
                                        </Button>

                                        <Button Click="DeleteCard_Click"
                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                            Padding="10,8"
                                            ToolTip.Tip="Delete Card">
                                            <Path Classes="icon editorAction danger" Data="{StaticResource IconDelete}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>