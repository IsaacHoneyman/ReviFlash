<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:models="using:ReviFlash.Models"
    xmlns:views="using:ReviFlash.Views"
    xmlns:converters="using:ReviFlash.Converters"
    xmlns:controls="using:ReviFlash.Views.Controls"
    x:Class="ReviFlash.Views.DeckEditorView"
    x:DataType="vm:DeckEditorViewModel"
    Background="{DynamicResource AppBackground}">

    <UserControl.Resources>
        <converters:BoolToOptionMarkerConverter x:Key="BoolToOptionMarkerConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://ReviFlash/Views/Controls/FormatStyles.axaml" />
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>
        <Style Selector="TextBox.multiline">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="MaxHeight" Value="240" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- LaTeX preview under a field: "small" for options, pairs and labels -->
        <Style Selector="Border.preview">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinHeight" Value="60" />
        </Style>
        <Style Selector="Border.preview.small">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button.addRow">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.removeRow">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- A card's actions in the list: quiet until pointed at. -->
        <Style Selector="Button.cardAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <Style Selector="Button.cardAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
        </Style>
        <Style Selector="Border.editingRing">
            <Setter Property="BorderBrush" Value="{DynamicResource GroupCardBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- The card type as segments: a quiet track with the chosen one raised. -->
        <Style Selector="ListBox.segments">
            <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBackground}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="ListBox.segments ListBoxItem">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.segments ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segments ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ListBox.segments ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBackground}" />
        </Style>

        <Style Selector="Border.listCard views|MathText.front">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource SerifFont}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" Margin="32">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" Margin="0,0,0,24">
            <Button Classes="secondary" Content="← Back" Click="Back_Click" Height="38" Padding="12,0"
                VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Back (Esc)" />

            <TextBox Grid.Column="1" x:Name="NameBox"
                Text="{Binding DeckName, Mode=TwoWay}"
                MaxLength="100"
                LostFocus="NameBox_LostFocus"
                FontFamily="{DynamicResource SerifFont}" FontSize="26" FontWeight="SemiBold"
                Background="Transparent" BorderThickness="0,0,0,1"
                Foreground="{DynamicResource TextPrimary}" />

            <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" x:Name="CardCountText"
                Text="{Binding Cards.Count, StringFormat='{}{0} cards'}" FontSize="13" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1*, 1*">

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                x:Name="EditorScroll"
                Margin="0,0,8,0"
                Padding="0,0,16,0">
                <Grid>
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="22"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                        <StackPanel Spacing="12" x:Name="EditorPanel">
                        <TextBlock Classes="sectionTitle" Text="{Binding EditorTitle}" />

                        <!-- The card type as a row of segments -->
                        <ListBox x:Name="CardTypeBox" Classes="segments" ItemsSource="{Binding AvailableCardTypes}"
                            SelectedItem="{Binding SelectedCardType}" HorizontalAlignment="Left">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- Formatting toolbar: acts on the card field last clicked into -->
                        <controls:FormattingToolbar ShowBlank="{Binding IsClozeCardType}" FormatRequested="Toolbar_FormatRequested" />

                        <TextBlock Classes="fieldLabel" Text="{Binding FrontLabel}" />
                        <TextBox Classes="field multiline" x:Name="FrontBox" Text="{Binding NewFront, Mode=TwoWay}" />
                        <Border Classes="preview">
                            <views:MathText Text="{Binding NewFront}" ShowErrors="True" />
                        </Border>

                        <TextBlock Classes="fieldLabel" Text="{Binding BackLabel}" />
                        <TextBox Classes="field multiline" Text="{Binding NewBack, Mode=TwoWay}" />
                        <Border Classes="preview">
                            <views:MathText Text="{Binding NewBack}" ShowErrors="True" />
                        </Border>

                        <CheckBox IsVisible="{Binding IsFlipCardType}" IsChecked="{Binding NewIsReversible, Mode=TwoWay}"
                            Content="Also ask in reverse (back → front)"
                            ToolTip.Tip="Reviews ask this card both ways, as two separate questions." />

                        <StackPanel Spacing="6" IsVisible="{Binding IsClozeCardType}">
                            <CheckBox IsChecked="{Binding NewClozeTypeAnswer, Mode=TwoWay}"
                                Content="Answer by typing the hidden text" />
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                Text="Each \C{...} blank becomes its own question. Give blanks the same number, like \C1{...}, to hide them together." />
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsTypeCardType}">
                            <TextBlock Classes="fieldLabel" Text="Typed Answer (Accepted Input)" />
                            <TextBox Classes="field noImages" Text="{Binding NewTypeAnswer, Mode=TwoWay}" Height="40"
                                Watermark="What the user must type" />
                            <Border Classes="preview small" IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewTypeAnswer}" ShowErrors="True" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsTrueFalseCardType}">
                            <TextBlock Classes="fieldLabel" Text="True/False Labels" />

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="caption" Text="True:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding NewTrueOptionText, Mode=TwoWay}"
                                    Watermark="Label for true option" />
                            </Grid>
                            <Border Classes="preview small" IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewTrueOptionText}" ShowErrors="True" />
                            </Border>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="caption" Text="False:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding NewFalseOptionText, Mode=TwoWay}"
                                    Watermark="Label for false option" />
                            </Grid>
                            <Border Classes="preview small" IsVisible="{Binding ShowAdditionalFieldLatexPreviews}">
                                <views:MathText Text="{Binding NewFalseOptionText}" ShowErrors="True" />
                            </Border>

                            <CheckBox IsChecked="{Binding NewTrueFalseAnswerIsTrue, Mode=TwoWay}"
                                Content="Correct answer is the True label" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsMultiChoiceCardType}">
                            <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Options (max 8)" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Classes="addRow" Click="AddOption_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconPlus}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Add Option" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MultiChoiceOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MultiChoiceOptionEditor">
                                        <StackPanel Spacing="4" Margin="0,4,0,4">
                                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,2">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCorrect, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Classes="field" Text="{Binding OptionText, Mode=TwoWay}"
                                                    Watermark="Option text" />
                                                <Button Grid.Column="2" Classes="removeRow" Click="RemoveOption_Click" ToolTip.Tip="Remove option">
                                                    <Path Classes="icon" Width="12" Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <Border Classes="preview small"
                                                IsVisible="{Binding $parent[views:DeckEditorView].((vm:DeckEditorViewModel)DataContext).ShowAdditionalFieldLatexPreviews}">
                                                <views:MathText Text="{Binding OptionText}" ShowErrors="True" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="hint" TextWrapping="Wrap" Text="Tick each correct option. Users can select multiple answers during review." />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsMatchCardType}">
                            <TextBlock Classes="fieldLabel" Text="Match cards use fixed question text: Match The Cards" Margin="0" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Match Pairs (max 8)" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Classes="addRow" Click="AddMatchPair_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconPlus}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Add Pair" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MatchPairs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchPairEditor">
                                        <StackPanel Spacing="4" Margin="0,4,0,4">
                                            <Grid ColumnDefinitions="*, Auto, *, Auto" Margin="0,0,0,2">
                                                <TextBox Grid.Column="0" Classes="field" Text="{Binding LeftText, Mode=TwoWay}" Watermark="Left text" />
                                                <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconLeftRight}" Margin="8,0"
                                                    Stroke="{DynamicResource TextSecondary}" />
                                                <TextBox Grid.Column="2" Classes="field" Text="{Binding RightText, Mode=TwoWay}" Watermark="Right text" />
                                                <Button Grid.Column="3" Classes="removeRow" Click="RemoveMatchPair_Click" ToolTip.Tip="Remove pair">
                                                    <Path Classes="icon" Width="12" Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="8" IsVisible="{Binding $parent[views:DeckEditorView].((vm:DeckEditorViewModel)DataContext).ShowAdditionalFieldLatexPreviews}">
                                                <Border Grid.Column="0" Classes="preview small">
                                                    <views:MathText Text="{Binding LeftText}" ShowErrors="True" />
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondary}" />

                                                <Border Grid.Column="2" Classes="preview small">
                                                    <views:MathText Text="{Binding RightText}" ShowErrors="True" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox IsChecked="{Binding NewMatchKeepLeftOrder, Mode=TwoWay}"
                                Content="Keep the left side in this order"
                                ToolTip.Tip="Reviews show the left side as written. The right side is still shuffled." />

                            <TextBlock Classes="hint" TextWrapping="Wrap" Text="In review, left and right sides are shuffled and the user matches them." />
                        </StackPanel>

                        <TextBlock Classes="error" Text="{Binding ValidationMessage}"
                            IsVisible="{Binding HasValidationMessage}" />

                        <Button Classes="primary wide" Click="AddCard_Click" Content="{Binding SaveButtonText}"
                            Margin="0,10,0,0" Padding="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" x:Name="CardListScroll" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,0,-24,0"
                Padding="0,0,24,0">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCardsLoading}">
                        <controls:BusySpinner VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="Loading cards..." VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FlashCard">
                            <Panel Margin="0,0,0,12">
                                <Border Classes="card compact listCard">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="*, Auto">
                                        <TextBlock Grid.Column="1" Grid.Row="0" Classes="hint" Text="{Binding CardType}"
                                            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,8" />

                                        <StackPanel Grid.Column="0" Grid.RowSpan="2" Spacing="12" IsVisible="{Binding !IsMatchCard}">
                                            <views:MathText Classes="front" Text="{Binding Front}" />

                                            <Rectangle Height="1" Fill="{DynamicResource CardBorder}"
                                                Opacity="0.3" />

                                            <views:MathText Text="{Binding Back}" Foreground="{DynamicResource TextSecondary}" />

                                            <StackPanel Spacing="6" IsVisible="{Binding IsMultiChoiceCard}">
                                                <TextBlock Classes="caption" Text="Options preview" />
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                                    HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding MultiChoiceOptionsPreview}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:MultiChoicePreviewOption">
                                                                <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,6">
                                                                    <TextBlock Grid.Column="0"
                                                                        Text="{Binding IsCorrect, Converter={StaticResource BoolToOptionMarkerConverter}}"
                                                                        Classes="hint success"
                                                                        VerticalAlignment="Top" Margin="0,0,8,0" />
                                                                    <views:MathText Text="{Binding Text}" Grid.Column="1" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="0" Grid.RowSpan="2" Spacing="8" IsVisible="{Binding IsMatchCard}">
                                            <views:MathText Classes="front" Text="{Binding Front}" />

                                            <TextBlock Classes="caption" Text="Match pairs preview" />

                                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding MatchPairsPreview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:MatchPreviewPair">
                                                            <Grid ColumnDefinitions="2*, Auto, *" Margin="0,0,0,8">
                                                                <views:MathText Text="{Binding LeftText}" Grid.Column="0" />

                                                                <TextBlock Grid.Column="1" Text="→" Margin="8,0"
                                                                    Foreground="{DynamicResource TextSecondary}" />

                                                                <views:MathText Text="{Binding RightText}" Grid.Column="2" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Grid.Row="1"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="8" Margin="10,0,0,0">
                                            <Button Classes="cardAction" Click="MoveCard_Click"
                                                ToolTip.Tip="Move or Copy to a Set">
                                                <Path Classes="icon editorAction" Data="{StaticResource IconMove}" />
                                            </Button>

                                            <Button Classes="cardAction" Click="NewCardFromThis_Click"
                                                ToolTip.Tip="New Card From This">
                                                <Path Classes="icon editorAction" Data="{StaticResource IconCopy}" />
                                            </Button>

                                            <Button Classes="cardAction" Click="EditCard_Click"
                                                ToolTip.Tip="Edit Card">
                                                <Path Classes="icon editorAction" Data="{StaticResource IconEdit}" />
                                            </Button>

                                            <Button Classes="cardAction" Click="DeleteCard_Click"
                                                ToolTip.Tip="Delete Card">
                                                <Path Classes="icon editorAction danger" Data="{StaticResource IconDelete}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Outlines the card that's open in the editor -->
                                <Border Classes="editingRing" IsHitTestVisible="False">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static converters:AllEqualConverter.Instance}">
                                            <Binding Path="ID" />
                                            <Binding Path="$parent[views:DeckEditorView].((vm:DeckEditorViewModel)DataContext).EditingCard.ID" FallbackValue="{x:Null}" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
