<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.ReviewView"
    x:DataType="vm:ReviewViewModel">

    <UserControl.Styles>
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.prompt">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <!-- The key that picks an option or chip -->
        <Style Selector="TextBlock.key">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Match cards: items on the left, each filled from the answers in the pane on the right -->
        <Style Selector="Border.matchPane">
            <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="TextBlock.paneTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.matchRow">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.matchRow.current">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.matchRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        </Style>
        <!-- Where an item's answer goes: outlined while empty, filled once placed -->
        <Style Selector="Border.slot">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slot.filled">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Button.chip:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <!-- A checked match pair: a line under each, and a soft red wash on the ones you got wrong. -->
        <Style Selector="Border.matchResult">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,11" />
        </Style>
        <Style Selector="Border.matchResult.wrong">
            <Setter Property="Background" Value="{DynamicResource DangerTintBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- The bottom bar's buttons: their own width, side by side. -->
        <Style Selector="Button.bar">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- The answer you're most likely to give, in the text colour rather than the accent. -->
        <Style Selector="Button.bar.strong">
            <Setter Property="Background" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AppBackground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.bar.strong:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bar.strong:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AppBackground}" />
        </Style>
        <Style Selector="Button.bar.strong:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.bar.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- What you study is set in the serif. -->
        <Style Selector="views|MathText.question">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource SerifFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="views|MathText.answer">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource SerifFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
    </UserControl.Styles>

    <!-- A thin progress line, a header, the card (scrolling when it's long) and a bar of actions pinned at the bottom. -->
    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <ProgressBar Grid.Row="0" Value="{Binding ProgressPercentage}" Maximum="100"
            Height="3" MinHeight="3" CornerRadius="0" IsVisible="{Binding ShouldShowProgress}" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="16" Margin="16,12,24,0">
            <Button Classes="iconButton" Background="Transparent" Focusable="False" Click="QuitSession_Click" ToolTip.Tip="Quit and save progress (Esc)">
                <Path Classes="icon" Data="{StaticResource IconClose}" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="{Binding SessionTitle}" FontFamily="{DynamicResource SerifFont}" FontSize="18" FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource IconLeftRight}" Stroke="{DynamicResource TextSecondary}"
                        IsVisible="{Binding IsReversedCard}" ToolTip.Tip="Asked back to front" />
                    <TextBlock Classes="prompt" Text="{Binding CardLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                <TextBlock Classes="prompt" VerticalAlignment="Center" IsVisible="{Binding ShouldShowProgress}">
                    <Run Text="{Binding CurrentNumber}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextPrimary}" />
                    <Run Text="{Binding TotalCards, StringFormat='of {0}'}" />
                </TextBlock>
                <TextBlock Classes="prompt" VerticalAlignment="Center" IsVisible="{Binding ShouldShowAnswerStreak}"
                    ToolTip.Tip="{Binding BestAnswerStreakText}" Text="{Binding CurrentAnswerStreakText}" />
                <TextBlock Classes="prompt" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}"
                    Text="{Binding TimerText}" IsVisible="{Binding ShouldShowTimer}" />
                <Button Classes="iconButton" Background="Transparent" Focusable="False" IsVisible="{Binding CanEditCard}"
                    Click="EditCard_Click" ToolTip.Tip="Edit this card (E)">
                    <Path Classes="icon" Data="{StaticResource IconEdit}" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- A comfortable reading column, centred, with the text left-aligned in it. -->
            <StackPanel MaxWidth="{Binding CardMaxWidth}" Margin="48,40,48,48" Spacing="22" VerticalAlignment="Center">
                <views:MathText Classes="question" Text="{Binding CurrentCard.Front}" HorizontalAlignment="Stretch" />

                <Border Width="64" Height="1.5" HorizontalAlignment="Left" Background="{DynamicResource GroupCardBorder}"
                    IsVisible="{Binding ShowBackSection}" />

                <views:MathText Classes="answer" Text="{Binding CurrentCard.Back}" HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowBackSection}" />

                <StackPanel Spacing="14">
                    <!-- Result, for every card type that's checked rather than self-marked -->
                    <Panel IsVisible="{Binding IsAnswerChecked}">
                        <TextBlock Classes="sectionTitle" Text="✓ Correct" Foreground="{DynamicResource SuccessForeground}"
                            IsVisible="{Binding IsAnswerCorrect}" />
                        <TextBlock Classes="sectionTitle" Text="✕ Incorrect" Foreground="{DynamicResource DangerForeground}"
                            IsVisible="{Binding !IsAnswerCorrect}" />
                    </Panel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsTypeCard}">
                        <StackPanel Spacing="12" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBox x:Name="TypedAnswerBox" Text="{Binding UserTypedAnswer, Mode=TwoWay}"
                                Watermark="Type your answer..."
                                CornerRadius="8" Padding="12, 10" FontSize="16"
                                Background="{DynamicResource CardBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1.5" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Correct answer:" />
                            <TextBlock Text="{Binding CurrentTypeCardAnswer}"
                                Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsMultiChoiceCard}">
                        <StackPanel Spacing="10" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Select all options you think are correct:" />

                            <ItemsControl ItemsSource="{Binding MultiChoiceAnswerOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReviewOptionItem">
                                        <Border Background="{DynamicResource SurfaceOverlayBackground}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,3">
                                            <!-- The whole row ticks the box -->
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False" Cursor="Hand"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <views:MathText Text="{Binding OptionText}" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Grid.Column="1" Classes="key" Text="{Binding NumberText}" Margin="10,0,0,0" />
                                                </Grid>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="12" IsVisible="{Binding IsAnswerChecked}">
                            <StackPanel>
                                <TextBlock Classes="prompt" Text="Correct options:" />
                                <ItemsControl ItemsSource="{Binding MultiChoiceAnswerOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReviewOptionItem">
                                            <StackPanel Spacing="6" Margin="0,2,0,0" IsVisible="{Binding IsCorrect}" Orientation="Horizontal">
                                                <TextBlock Text="✓" FontSize="15" Foreground="{DynamicResource SuccessForeground}" VerticalAlignment="Top" />
                                                <views:MathText Text="{Binding OptionText}" HorizontalAlignment="Stretch" FontSize="15" Foreground="{DynamicResource SuccessForeground}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasSelectedWrongOptions}">
                                <TextBlock Classes="body" Text="You selected these incorrectly:"
                                    Foreground="{DynamicResource DangerForeground}" />
                                <ItemsControl ItemsSource="{Binding SelectedWrongOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <StackPanel Spacing="6" Margin="0,2,0,0" Orientation="Horizontal">
                                                <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource DangerForeground}" VerticalAlignment="Top" />
                                                <views:MathText Text="{Binding .}" HorizontalAlignment="Stretch" FontSize="14" Foreground="{DynamicResource DangerForeground}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasMissedCorrectOptions}">
                                <TextBlock Classes="body" Text="You missed these correct options:"
                                    Foreground="{DynamicResource WarningForeground}" />
                                <ItemsControl ItemsSource="{Binding MissedCorrectOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <StackPanel Spacing="6" Margin="0,2,0,0" Orientation="Horizontal">
                                                <TextBlock Text="•" FontSize="14" Foreground="{DynamicResource WarningForeground}" VerticalAlignment="Top" />
                                                <views:MathText Text="{Binding .}" HorizontalAlignment="Stretch" FontSize="14" Foreground="{DynamicResource WarningForeground}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsMatchCard}">
                        <StackPanel Spacing="14" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Pick an answer for the highlighted item. Click an item to change its answer."
                                TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                            <Grid ColumnDefinitions="3*, 20, 2*">
                                <Border Classes="matchPane">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="paneTitle" Text="Items" />
                                        <ItemsControl ItemsSource="{Binding MatchRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReviewMatchRow">
                                                    <Button Classes="matchRow" Classes.current="{Binding IsCurrent}" Margin="0,4" Click="MatchRow_Click">
                                                        <Grid ColumnDefinitions="*, Auto, *">
                                                            <views:MathText Text="{Binding LeftText}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                                FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                                            <TextBlock Grid.Column="1" Text="→" Margin="10,0"
                                                                VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                            <Border Grid.Column="2" Classes="slot filled" IsVisible="{Binding HasSelection}">
                                                                <!-- Shown in full in the Answers pane, so kept short here -->
                                                                <views:MathText Text="{Binding SelectedRightText}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                                    MaxLines="2" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                                                            </Border>
                                                            <Border Grid.Column="2" Classes="slot" IsVisible="{Binding !HasSelection}">
                                                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="matchPane">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="paneTitle" Text="Answers" />
                                        <ItemsControl ItemsSource="{Binding MatchChips}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReviewMatchChip">
                                                    <!-- Placed answers stay where they are (so their numbers don't shift), faded -->
                                                    <Button Classes="chip" IsEnabled="{Binding !IsUsed}" Click="MatchChip_Click">
                                                        <Grid ColumnDefinitions="22, *, 22">
                                                            <TextBlock Classes="key" Text="{Binding NumberText}" />
                                                            <views:MathText Grid.Column="1" Text="{Binding Text}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                                FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Each pair as answered, with the right answer under any that were wrong -->
                        <ItemsControl ItemsSource="{Binding MatchRows}" IsVisible="{Binding IsAnswerChecked}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReviewMatchRow">
                                    <Border Classes="matchResult" Classes.wrong="{Binding !IsCorrect}">
                                        <Grid ColumnDefinitions="28, 220, *" ColumnSpacing="12">
                                            <TextBlock Text="✓" FontSize="15" VerticalAlignment="Top" Foreground="{DynamicResource SuccessForeground}" IsVisible="{Binding IsCorrect}" />
                                            <TextBlock Text="✕" FontSize="15" VerticalAlignment="Top" Foreground="{DynamicResource DangerForeground}" IsVisible="{Binding !IsCorrect}" />
                                            <views:MathText Grid.Column="1" Text="{Binding LeftText}" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                FontSize="15" TextElement.FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top">
                                                <views:MathText Text="{Binding SelectedRightText}" HorizontalAlignment="Stretch" FontSize="16"
                                                    TextElement.FontFamily="{DynamicResource SerifFont}" Foreground="{DynamicResource TextPrimary}"
                                                    IsVisible="{Binding IsCorrect}" />
                                                <views:MathText Text="{Binding SelectedRightText}" HorizontalAlignment="Stretch" FontSize="16"
                                                    TextElement.FontFamily="{DynamicResource SerifFont}" Foreground="{DynamicResource TextSecondary}" Opacity="0.8"
                                                    IsVisible="{Binding !IsCorrect}" />
                                                <TextBlock Text="Nothing chosen" FontSize="15" Foreground="{DynamicResource TextSecondary}"
                                                    IsVisible="{Binding !HasSelection}" />
                                                <views:MathText Text="{Binding CorrectRightText}" HorizontalAlignment="Stretch" FontSize="16"
                                                    TextElement.FontFamily="{DynamicResource SerifFont}" Foreground="{DynamicResource TextPrimary}"
                                                    IsVisible="{Binding !IsCorrect}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsTrueFalseCard}">
                        <StackPanel Spacing="10" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Pick the correct option:" />

                            <!-- Neutral until answered, so the colours don't hint at the answer -->
                            <UniformGrid Rows="1" ColumnSpacing="12">
                                <Button Classes="action secondary" Focusable="False" Content="{Binding CurrentTrueFalseTrueOptionText}" Click="TrueAnswer_Click" />
                                <Button Classes="action secondary" Focusable="False" Content="{Binding CurrentTrueFalseFalseOptionText}" Click="FalseAnswer_Click" />
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Correct option:" />
                            <TextBlock Text="{Binding CurrentTrueFalseCorrectOptionText}"
                                Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,14,24,18">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="bar strong" Content="Show Answer" Click="ShowAnswer_Click"
                        IsVisible="{Binding ShowAnswerButtonVisible}" />

                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowMarkButtons}">
                        <Button Classes="bar secondary" Click="Incorrect_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource IconClose}" Stroke="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="Incorrect" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="bar strong" Click="Correct_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="Correct" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Classes="bar strong" Content="Check Answer" Click="SubmitAnswer_Click">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsAnswerChecked" />
                                <Binding Path="!IsFlipCard" />
                                <Binding Path="!IsTrueFalseCard" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>

                    <Button Classes="bar strong" Content="Next Card" Click="NextCard_Click" IsVisible="{Binding IsAnswerChecked}" />

                    <!-- Puts the card back in the queue unmarked -->
                    <Button Classes="bar plain" Content="Retry Later" Click="RetryLater_Click" IsVisible="{Binding ShowFlipRetryLater}" />
                    <Button Classes="bar plain" Content="Retry Later" Click="RetryLater_Click">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsAnswerChecked" />
                                <Binding Path="CanRetryLater" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Classes="bar plain" Content="Skip" Click="SkipCard_Click"
                        IsVisible="{Binding CanSkip}" ToolTip.Tip="Skip this card (S)" />
                </StackPanel>

                <TextBlock Grid.Column="2" Classes="caption" Text="{Binding KeyboardHint}" VerticalAlignment="Center"
                    TextAlignment="Right" TextWrapping="Wrap" MaxWidth="560" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
