<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.ReviewView"
    x:DataType="vm:ReviewViewModel">

    <UserControl.Styles>
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.prompt">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <!-- The key that picks an option or chip -->
        <Style Selector="TextBlock.key">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Match cards: items on the left, each filled from the answers in the pane on the right -->
        <Style Selector="Border.matchPane">
            <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="TextBlock.paneTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.matchRow">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.matchRow.current">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.matchRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        </Style>
        <!-- Where an item's answer goes: outlined while empty, filled once placed -->
        <Style Selector="Border.slot">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slot.filled">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        </Style>
        <Style Selector="Button.chip:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Border.matchResult">
            <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessForeground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="Border.matchResult.wrong">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerForeground}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *" Margin="24, 16, 24, 16" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Spacing="8">
                <StackPanel IsVisible="{Binding ShouldShowTimer}">
                    <TextBlock Classes="prompt" Text="Time" />
                    <TextBlock Text="{Binding TimerText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding ShouldShowAnswerStreak}">
                    <TextBlock Classes="prompt" Text="Streak" />
                    <TextBlock Text="{Binding CurrentAnswerStreakText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Classes="caption" Text="{Binding BestAnswerStreakText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" IsVisible="{Binding ShouldShowProgress}">
                <TextBlock Classes="prompt" Text="Progress" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ProgressCardCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Classes="prompt" Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="4" CornerRadius="2" Margin="0,4,0,0" Width="100" />
            </StackPanel>

            <Button Grid.Column="2" Classes="action secondary small" Content="Quit" Click="QuitSession_Click"
                VerticalAlignment="Top" ToolTip.Tip="Quit and save progress (Esc)" />
        </Grid>

        <Grid Grid.Row="1" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                VerticalAlignment="Center"
                Margin="0,0,-16,0"
                Padding="0,0,16,0">
            <!-- Grows with the window up to a comfortable reading width, keeping a margin either side -->
            <Border MaxWidth="{Binding CardMaxWidth}" Margin="48,0" Background="{DynamicResource CardBackground}" CornerRadius="26"
                Padding="40,32" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                <!-- Card type, plus the deck in a study group -->
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource IconLeftRight}" Stroke="{DynamicResource TextSecondary}"
                        IsVisible="{Binding IsReversedCard}" ToolTip.Tip="Asked back to front" />
                    <TextBlock Text="{Binding CardLabel}" FontSize="14"
                        Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <!-- Centred while they fit on one line; anything longer reads better left-aligned -->
                <views:MathText Text="{Binding CurrentCard.Front}" HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource TextPrimary}" IsCentered="True" />

                <!-- Only once there's an answer to show, so unanswered cards have no empty band -->
                <Separator Background="{DynamicResource CardBorder}" Opacity="0.3"
                    IsVisible="{Binding ShowBackSection}" />

                <views:MathText Text="{Binding CurrentCard.Back}" IsVisible="{Binding ShowBackSection}" HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource TextSecondary}" IsCentered="True" />

                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <!-- Result, for every card type that's checked rather than self-marked -->
                    <Panel IsVisible="{Binding IsAnswerChecked}">
                        <TextBlock Text="✓ Correct!" FontSize="24" FontWeight="Bold"
                            Foreground="{DynamicResource SuccessForeground}" HorizontalAlignment="Center"
                            IsVisible="{Binding IsAnswerCorrect}" />
                        <TextBlock Text="✕ Incorrect" FontSize="24" FontWeight="Bold"
                            Foreground="{DynamicResource DangerForeground}" HorizontalAlignment="Center"
                            IsVisible="{Binding !IsAnswerCorrect}" />
                    </Panel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsFlipCard}">
                        <Button Classes="action primary" Content="Show Answer" Click="ShowAnswer_Click"
                            IsVisible="{Binding ShowAnswerButtonVisible}" />

                        <UniformGrid Rows="1" ColumnSpacing="12" IsVisible="{Binding IsAnswerRevealed}">
                            <Button Classes="action danger" Click="Incorrect_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Data="{StaticResource IconClose}" Stroke="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="Incorrect" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="action success" Click="Correct_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="Correct" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Puts the card back in the queue unmarked -->
                        <Button Classes="action secondary" Content="Retry Later" Click="RetryLater_Click"
                            IsVisible="{Binding ShowFlipRetryLater}" />
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsTypeCard}">
                        <StackPanel Spacing="12" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBox x:Name="TypedAnswerBox" Text="{Binding UserTypedAnswer, Mode=TwoWay}"
                                Watermark="Type your answer..."
                                CornerRadius="8" Padding="12, 10" FontSize="16"
                                Background="{DynamicResource CardBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1.5" />
                            <Button Classes="action primary" Content="Submit Answer" Click="SubmitAnswer_Click" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Correct answer:" />
                            <TextBlock Text="{Binding CurrentTypeCardAnswer}"
                                Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsMultiChoiceCard}">
                        <StackPanel Spacing="10" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Select all options you think are correct:" />

                            <ItemsControl ItemsSource="{Binding MultiChoiceAnswerOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReviewOptionItem">
                                        <Border Background="{DynamicResource SurfaceOverlayBackground}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,3">
                                            <!-- The whole row ticks the box -->
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False" Cursor="Hand"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <views:MathText Text="{Binding OptionText}" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Grid.Column="1" Classes="key" Text="{Binding NumberText}" Margin="10,0,0,0" />
                                                </Grid>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="action primary" Content="Submit Answer" Click="SubmitAnswer_Click" />
                        </StackPanel>

                        <StackPanel Spacing="12" IsVisible="{Binding IsAnswerChecked}">
                            <StackPanel>
                                <TextBlock Classes="prompt" Text="Correct options:" />
                                <ItemsControl ItemsSource="{Binding MultiChoiceAnswerOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReviewOptionItem">
                                            <StackPanel Spacing="6" Margin="0,2,0,0" IsVisible="{Binding IsCorrect}" Orientation="Horizontal">
                                                <TextBlock Text="✓" FontSize="15" Foreground="{DynamicResource SuccessForeground}" VerticalAlignment="Top" />
                                                <views:MathText Text="{Binding OptionText}" HorizontalAlignment="Stretch" FontSize="15" Foreground="{DynamicResource SuccessForeground}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasSelectedWrongOptions}">
                                <TextBlock Text="You selected these incorrectly:" FontSize="14"
                                    Foreground="{DynamicResource DangerForeground}" />
                                <ItemsControl ItemsSource="{Binding SelectedWrongOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <StackPanel Spacing="6" Margin="0,2,0,0" Orientation="Horizontal">
                                                <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource DangerForeground}" VerticalAlignment="Top" />
                                                <views:MathText Text="{Binding .}" HorizontalAlignment="Stretch" FontSize="14" Foreground="{DynamicResource DangerForeground}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasMissedCorrectOptions}">
                                <TextBlock Text="You missed these correct options:" FontSize="14"
                                    Foreground="{DynamicResource WarningForeground}" />
                                <ItemsControl ItemsSource="{Binding MissedCorrectOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <StackPanel Spacing="6" Margin="0,2,0,0" Orientation="Horizontal">
                                                <TextBlock Text="•" FontSize="14" Foreground="{DynamicResource WarningForeground}" VerticalAlignment="Top" />
                                                <views:MathText Text="{Binding .}" HorizontalAlignment="Stretch" FontSize="14" Foreground="{DynamicResource WarningForeground}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsMatchCard}">
                        <StackPanel Spacing="14" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Pick an answer for the highlighted item. Click an item to change its answer."
                                TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                            <Grid ColumnDefinitions="3*, 20, 2*">
                                <Border Classes="matchPane">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="paneTitle" Text="Items" />
                                        <ItemsControl ItemsSource="{Binding MatchRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReviewMatchRow">
                                                    <Button Classes="matchRow" Classes.current="{Binding IsCurrent}" Margin="0,4" Click="MatchRow_Click">
                                                        <Grid ColumnDefinitions="*, Auto, *">
                                                            <views:MathText Text="{Binding LeftText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsCentered="True"
                                                                FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                                            <TextBlock Grid.Column="1" Text="→" Margin="10,0"
                                                                VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                            <Border Grid.Column="2" Classes="slot filled" IsVisible="{Binding HasSelection}">
                                                                <!-- Shown in full in the Answers pane, so kept short here -->
                                                                <views:MathText Text="{Binding SelectedRightText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsCentered="True"
                                                                    MaxLines="2" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                                                            </Border>
                                                            <Border Grid.Column="2" Classes="slot" IsVisible="{Binding !HasSelection}">
                                                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="matchPane">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="paneTitle" Text="Answers" />
                                        <ItemsControl ItemsSource="{Binding MatchChips}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReviewMatchChip">
                                                    <!-- Placed answers stay where they are (so their numbers don't shift), faded -->
                                                    <Button Classes="chip" IsEnabled="{Binding !IsUsed}" Click="MatchChip_Click">
                                                        <Grid ColumnDefinitions="22, *, 22">
                                                            <TextBlock Classes="key" Text="{Binding NumberText}" />
                                                            <views:MathText Grid.Column="1" Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" IsCentered="True"
                                                                FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Button Classes="action primary" Content="Submit Answer" Click="SubmitAnswer_Click" />
                        </StackPanel>

                        <!-- Each pair as answered, with the right answer under any that were wrong -->
                        <ItemsControl ItemsSource="{Binding MatchRows}" IsVisible="{Binding IsAnswerChecked}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReviewMatchRow">
                                    <Border Classes="matchResult" Classes.wrong="{Binding !IsCorrect}">
                                        <Grid ColumnDefinitions="*, Auto, *">
                                            <views:MathText Text="{Binding LeftText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsCentered="True"
                                                FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="→" Margin="16,0"
                                                VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" IsVisible="{Binding IsCorrect}">
                                                    <TextBlock Text="✓" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource SuccessForeground}" />
                                                    <views:MathText Grid.Column="1" Text="{Binding SelectedRightText}" VerticalAlignment="Center" IsCentered="True"
                                                        FontSize="15" Foreground="{DynamicResource SuccessForeground}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" IsVisible="{Binding !IsCorrect}">
                                                    <TextBlock Text="✕" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource DangerForeground}" />
                                                    <views:MathText Grid.Column="1" Text="{Binding SelectedRightText}" VerticalAlignment="Center" IsCentered="True"
                                                        FontSize="15" Foreground="{DynamicResource DangerForeground}" IsVisible="{Binding HasSelection}" />
                                                    <TextBlock Grid.Column="1" Text="Nothing chosen" FontSize="15" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource DangerForeground}" IsVisible="{Binding !HasSelection}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" IsVisible="{Binding !IsCorrect}">
                                                    <TextBlock Text="✓" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource SuccessForeground}" />
                                                    <views:MathText Grid.Column="1" Text="{Binding CorrectRightText}" VerticalAlignment="Center" IsCentered="True"
                                                        FontSize="15" Foreground="{DynamicResource SuccessForeground}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsTrueFalseCard}">
                        <StackPanel Spacing="10" IsVisible="{Binding !IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Pick the correct option:" />

                            <!-- Neutral until answered, so the colours don't hint at the answer -->
                            <UniformGrid Rows="1" ColumnSpacing="12">
                                <Button Classes="action secondary" Content="{Binding CurrentTrueFalseTrueOptionText}" Click="TrueAnswer_Click" />
                                <Button Classes="action secondary" Content="{Binding CurrentTrueFalseFalseOptionText}" Click="FalseAnswer_Click" />
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsAnswerChecked}">
                            <TextBlock Classes="prompt" Text="Correct option:" />
                            <TextBlock Text="{Binding CurrentTrueFalseCorrectOptionText}"
                                Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- After any checked answer: Retry Later beside Next (Next alone if retrying is off) -->
                    <UniformGrid Rows="1" ColumnSpacing="12" Margin="0,4,0,0" IsVisible="{Binding IsAnswerChecked}">
                        <Button Classes="action secondary" Content="Retry Later" Click="RetryLater_Click"
                            IsVisible="{Binding CanRetryLater}" />
                        <Button Classes="action primary" Content="Next" Click="NextCard_Click" />
                    </UniformGrid>
                </StackPanel>

                <TextBlock Classes="caption" Text="{Binding KeyboardHint}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                    Opacity="0.75" />
                </StackPanel>
            </Border>
            </ScrollViewer>

            <Button Classes="action secondary small" Content="Skip" Click="SkipCard_Click"
                VerticalAlignment="Bottom" Margin="0,0,24,16"
                IsVisible="{Binding ShouldShowSkipButton}" ToolTip.Tip="Skip this card (S)" />
        </Grid>
    </Grid>
</UserControl>
