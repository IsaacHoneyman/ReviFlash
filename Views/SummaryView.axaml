<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    x:Class="ReviFlash.Views.SummaryView"
    x:DataType="vm:SummaryViewModel">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="420" Background="{DynamicResource CardBackground}" CornerRadius="26"
            Padding="32">
            <StackPanel Spacing="20" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Classes="title" Text="Session Complete!" HorizontalAlignment="Center" />
                    <TextBlock Classes="body" Text="{Binding SessionMarker}"
                        Foreground="{DynamicResource WarningForeground}" FontStyle="Italic" HorizontalAlignment="Center"
                        IsVisible="{Binding IsPartialSession}" />
                </StackPanel>
                <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}" FontSize="64"
                    FontWeight="Black" Foreground="{DynamicResource GradientStart}" HorizontalAlignment="Center" />
                <TextBlock Classes="heading" Text="{Binding Grade, StringFormat='Grade: {0}'}" HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Classes="heading" Text="{Binding TimeFormatted, StringFormat='Time: {0}'}" HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}" />
                <Button Classes="action primary" Content="Finish" Click="ReturnToDashboard_Click" IsDefault="True" IsCancel="True"
                    Margin="0,20,0,0" ToolTip.Tip="Back to your sets (Enter)" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
