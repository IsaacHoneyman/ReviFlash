<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    x:Class="ReviFlash.Views.SummaryView"
    x:DataType="vm:SummaryViewModel">

    <!-- The result set on the page like a card's answer: the score large, grade and time under it. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Width="420">
        <TextBlock Classes="title" Text="Session complete" HorizontalAlignment="Center" />
        <TextBlock Classes="body" Text="{Binding SessionMarker}"
            Foreground="{DynamicResource WarningForeground}" FontStyle="Italic" HorizontalAlignment="Center"
            IsVisible="{Binding IsPartialSession}" />

        <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}" FontFamily="{DynamicResource SerifFont}" FontSize="96"
            FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,12,0,0" />
        <Border Width="64" Height="1.5" Background="{DynamicResource GroupCardBorder}" HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Classes="heading secondary" Text="{Binding Grade, StringFormat='Grade {0}'}" />
            <TextBlock Classes="heading secondary" Text="{Binding TimeFormatted}" FontFamily="{DynamicResource MonoFont}" />
        </StackPanel>

        <Button Classes="primary" Content="Finish" Click="ReturnToDashboard_Click" IsDefault="True" IsCancel="True"
            Height="46" Width="200" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            Focusable="False" Margin="0,28,0,0" ToolTip.Tip="Back to your sets (Enter)" />
    </StackPanel>
</UserControl>
