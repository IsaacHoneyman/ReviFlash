<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.SyntaxGuideWindow"
    x:DataType="views:SyntaxGuideWindow"
    Title="Formatting Guide"
    Width="860" Height="720" MinWidth="560" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <Style Selector="SelectableTextBlock.source">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </Window.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Text="Formatting Guide" FontSize="28" FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                    Text="The toolbar above the card fields does the common ones for you: select some text and press a button (or its shortcut). Everything here can also be typed. Each example shows what you type and how it looks; use the copy button to paste one into a card." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:GuideSection">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" />

                                <Grid ColumnDefinitions="170, *, *, Auto" ColumnSpacing="16" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="What" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="You type" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="You get" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="views:GuideRow">
                                            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid ColumnDefinitions="170, *, *, Auto" ColumnSpacing="16">
                                                    <TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap"
                                                        VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                    <SelectableTextBlock Grid.Column="1" Classes="source" Text="{Binding Source}" />
                                                    <views:MathText Grid.Column="2" Text="{Binding Source}" FontSize="15"
                                                        VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                                    <Button Grid.Column="3" Click="Copy_Click" ToolTip.Tip="Copy"
                                                        Background="{DynamicResource BadgeBackground}" CornerRadius="6" Padding="8,6"
                                                        VerticalAlignment="Center">
                                                        <Path Classes="icon" Width="14" Data="{StaticResource IconCopy}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
