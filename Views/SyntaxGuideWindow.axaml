<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.SyntaxGuideWindow"
    x:DataType="views:SyntaxGuideWindow"
    Title="Help"
    Width="860" Height="720" MinWidth="560" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.key">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Border.key TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="SelectableTextBlock.source">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </Window.Styles>

    <TabControl x:Name="Tabs" Margin="16,8,16,0">
    <TabItem Header="Formatting">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,16,16,32" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Classes="title" Text="Formatting Guide" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                    Text="The toolbar above the card fields does the common ones for you: select some text and press a button (or its shortcut). Everything here can also be typed. Each example shows what you type and how it looks; use the copy button to paste one into a card." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:GuideSection">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Classes="caption" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="170, *, *, Auto" ColumnSpacing="16" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Classes="hint" Text="What" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Classes="hint" Text="You type" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Classes="hint" Text="You get" FontWeight="Bold" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="views:GuideRow">
                                            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid ColumnDefinitions="170, *, *, Auto" ColumnSpacing="16">
                                                    <TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap"
                                                        VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                    <SelectableTextBlock Grid.Column="1" Classes="source" Text="{Binding Source}" />
                                                    <views:MathText Grid.Column="2" Text="{Binding Source}" FontSize="15"
                                                        VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                                    <Button Grid.Column="3" Click="Copy_Click" ToolTip.Tip="Copy"
                                                        Background="{DynamicResource BadgeBackground}" CornerRadius="6" Padding="8,6"
                                                        VerticalAlignment="Center">
                                                        <Path Classes="icon" Width="14" Data="{StaticResource IconCopy}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </TabItem>

    <TabItem Header="Keyboard Shortcuts">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,16,16,32" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Classes="title" Text="Keyboard Shortcuts" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                    Text="Where a row shows more than one key, either works. On macOS, use Cmd wherever Ctrl is shown." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ShortcutSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ShortcutSection">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Classes="caption" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="views:ShortcutRow">
                                            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid ColumnDefinitions="220, *" ColumnSpacing="16">
                                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="6" LineSpacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Classes="key">
                                                                    <TextBlock Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap"
                                                        VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </TabItem>
    </TabControl>
</Window>
