<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReviFlash.ViewModels"
        xmlns:models="using:ReviFlash.Models"
        xmlns:onlineData="using:ReviFlash.Data.Online"
        xmlns:views="using:ReviFlash.Views"
        x:Class="ReviFlash.Views.OnlineExportWindow"
        x:DataType="vm:OnlineExportViewModel"
        Title="Cloud Manager"
        Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

  <Grid Margin="32">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Cloud Manager" Foreground="{DynamicResource TextPrimary}" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Upload your sets, and manage the ones you've shared or kept private." Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountText}" Foreground="{DynamicResource TextSecondary}" FontSize="14" VerticalAlignment="Center"
                           ToolTip.Tip="Sign out from Settings."/>
            </StackPanel>
        </Grid>

        <!-- Both panes share one layout (title, then search, then list) so the two search bars line up. -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="24">

            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1.5" CornerRadius="20" Padding="20">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <TextBlock Text="On this device" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <views:DeckFolderBrowserView Grid.Row="1" DataContext="{Binding LocalBrowser}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1.5" CornerRadius="20" Padding="20">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <TextBlock Text="In the cloud" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding CloudSearchText, Mode=TwoWay}" Watermark="Search your cloud decks..."
                                     Height="36" VerticalContentAlignment="Center"
                                     CornerRadius="8" Padding="10,0" FontSize="14" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CloudSortOptions}" SelectedItem="{Binding SelectedCloudSortOption}"
                                      CornerRadius="8" Width="180" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource AppBackground}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                            <ItemsControl ItemsSource="{Binding FilteredCloudDecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="onlineData:FlashCardDeckMetadata">
                                        <Border Background="#14000000" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Border IsVisible="{Binding IsPrivate}" Background="{DynamicResource StatTileBackground}" CornerRadius="6" Padding="6,1"
                                                                ToolTip.Tip="Only you can see this deck. It isn't listed in community search.">
                                                            <TextBlock Text="Private" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding CardCount, StringFormat='{}{0} cards'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DownloadCountText}" IsVisible="{Binding !IsPrivate}" FontSize="12" Foreground="{DynamicResource GradientStart}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description, StringFormat='in {0}'}" FontSize="11"
                                                               IsVisible="{Binding HasDescription}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).DownloadCommand}" CommandParameter="{Binding}"
                                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                                            Padding="10,6" Height="30" MinHeight="30" VerticalContentAlignment="Center"
                                                            Cursor="Hand" ToolTip.Tip="Download to this device">
                                                        <Path Classes="icon" Data="{StaticResource IconDownload}" />
                                                    </Button>
                                                    <Button Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).SetupUpdateCommand}" CommandParameter="{Binding}"
                                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                                            Padding="10,6" Height="30" MinHeight="30" VerticalContentAlignment="Center"
                                                            Cursor="Hand" ToolTip.Tip="Update from a deck on this device">
                                                        <Path Classes="icon" Data="{StaticResource IconUpload}" />
                                                    </Button>
                                                    <Button Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).ToggleVisibilityCommand}" CommandParameter="{Binding}"
                                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                                            Padding="10,6" Height="30" MinHeight="30" VerticalContentAlignment="Center"
                                                            Cursor="Hand" ToolTip.Tip="{Binding VisibilityToggleText}">
                                                        <Panel>
                                                            <Path Classes="icon" Data="{StaticResource IconLock}" IsVisible="{Binding !IsPrivate}" />
                                                            <Path Classes="icon" Data="{StaticResource IconGlobe}" IsVisible="{Binding IsPrivate}" />
                                                        </Panel>
                                                    </Button>
                                                    <Button Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}"
                                                            Background="{DynamicResource BadgeBackground}" CornerRadius="8"
                                                            Padding="10,6" Height="30" MinHeight="30" VerticalContentAlignment="Center"
                                                            Cursor="Hand" ToolTip.Tip="Delete from the cloud">
                                                        <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *" ColumnSpacing="20" Margin="0,16,0,0">
            <CheckBox Grid.Column="0" IsChecked="{Binding IncludeFolderInfo}" Content="Include folder information"
                      Foreground="{DynamicResource TextSecondary}" FontSize="13"
                      ToolTip.Tip="Uploads carry the deck's folder path, and downloads rebuild it." />
            <CheckBox Grid.Column="1" IsChecked="{Binding UploadAsPrivate}" Content="Upload as private"
                      Foreground="{DynamicResource TextSecondary}" FontSize="13"
                      ToolTip.Tip="Private decks don't appear in community search. Use them to move decks between your own devices." />
            <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
        </Grid>
    </Grid>
    <!-- Overlay: pick the local deck that overwrites a cloud deck. -->
    <Grid Background="#B3000000" IsVisible="{Binding IsSelectingUpdateDeck}">
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1.5" CornerRadius="20" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="600" Height="560">
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" RowSpacing="12">

                <TextBlock Grid.Row="0" Text="Select Local Deck" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />

                <TextBlock Grid.Row="1" Text="Choose which local flashcard set you want to push to the cloud to overwrite this backup."
                           Foreground="{DynamicResource TextSecondary}" FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <views:DeckFolderBrowserView Grid.Row="2" DataContext="{Binding UpdateBrowser}" />

                <TextBlock Grid.Row="3" Text="{Binding SelectedLocalDeckForUpdate.Name, StringFormat='Selected: {0}', FallbackValue='No deck selected'}"
                           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="16">
                    <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelUpdateCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#70FFFFFF" Foreground="{DynamicResource TextPrimary}" 
                            CornerRadius="8" Padding="12,10" Cursor="Hand" FontWeight="SemiBold" />
                            
                    <Button Grid.Column="1" Content="Confirm Update" Command="{Binding ConfirmUpdateCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="{DynamicResource GradientStart}" Foreground="{DynamicResource PrimaryButtonForeground}"
                            CornerRadius="8" Padding="12,10" FontWeight="Bold" Cursor="Hand" />
                </Grid>
                
            </Grid>
        </Border>
    </Grid>
  </Grid>
</Window>