<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReviFlash.ViewModels"
        x:Class="ReviFlash.Views.OnlineExportWindow"
        x:DataType="vm:OnlineExportViewModel"
        Title="Online Export"
        Width="600" Height="400"
        WindowStartupLocation="CenterOwner">

  <Border Background="{DynamicResource AppBackground}" Padding="16">
    <TextBlock Text="Online Export (coming soon)" Foreground="{DynamicResource TextPrimary}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
  </Border>

</Window>
