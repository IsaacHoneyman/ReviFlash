<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ReviFlash.Views.Controls"
        xmlns:vm="using:ReviFlash.ViewModels"
        xmlns:models="using:ReviFlash.Models"
        xmlns:onlineData="using:ReviFlash.Data.Online"
        xmlns:views="using:ReviFlash.Views"
        x:Class="ReviFlash.Views.OnlineExportWindow"
        x:DataType="vm:OnlineExportViewModel"
        Title="Cloud Manager"
        Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

  <Grid Margin="32">

    <Grid RowDefinitions="Auto, *, Auto" IsEnabled="{Binding !IsSelectingUpdateDeck}">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Classes="title" Text="Cloud Manager" />
                <TextBlock Classes="caption" Text="Upload your sets and notes, and manage the ones you've shared or kept private." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:SegmentedSwitch FirstLabel="Sets" SecondLabel="Notes" IsSecond="{Binding ShowNotes}" />
                <TextBlock Classes="caption" Text="{Binding AccountText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           ToolTip.Tip="Sign out from Settings."/>
            </StackPanel>
        </Grid>

        <!-- Both panes share one layout (title, then search, then list) so the two search bars line up. -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="24">

            <Border Grid.Column="0" Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <TextBlock Classes="sectionTitle" Text="On This Device" />
                    <views:DeckFolderBrowserView Grid.Row="1" DataContext="{Binding LocalBrowser}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <TextBlock Classes="sectionTitle" Text="In the Cloud" />

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Classes="input" Text="{Binding CloudSearchText, Mode=TwoWay, Delay=120}" Watermark="{Binding CloudSearchWatermark}"
                                     Height="36" VerticalContentAlignment="Center"
                                     Padding="10,0" Background="{DynamicResource AppBackground}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CloudSortOptions}" SelectedItem="{Binding SelectedCloudSortOption}"
                                      CornerRadius="8" Width="180" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource AppBackground}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding IsLoadingCloudDecks}">
                            <controls:BusySpinner Classes="large" IsVisible="{Binding IsLoadingCloudDecks}" HorizontalAlignment="Center" />
                            <TextBlock Classes="caption" Text="{Binding LoadingText}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                            <ItemsControl ItemsSource="{Binding FilteredCloudDecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="onlineData:FlashCardDeckMetadata">
                                        <Border Classes="listRow">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Classes="sectionTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Border IsVisible="{Binding IsPrivate}" Background="{DynamicResource StatTileBackground}" CornerRadius="6" Padding="6,1"
                                                                ToolTip.Tip="Only you can see this. It isn't listed in community search.">
                                                            <TextBlock Classes="hint primary" Text="Private" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Classes="caption" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                                        <TextBlock Classes="caption accent" Text="{Binding DownloadCountText}" IsVisible="{Binding !IsPrivate}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Classes="hint" Text="{Binding Description, StringFormat='in {0}'}"
                                                               IsVisible="{Binding HasDescription}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="iconButton" Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).DownloadCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="Download to this device">
                                                        <Path Classes="icon" Data="{StaticResource IconDownload}" />
                                                    </Button>
                                                    <Button Classes="iconButton" Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).SetupUpdateCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="Update from one on this device">
                                                        <Path Classes="icon" Data="{StaticResource IconUpload}" />
                                                    </Button>
                                                    <Button Classes="iconButton" Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).ToggleVisibilityCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding VisibilityToggleText}">
                                                        <Panel>
                                                            <Path Classes="icon" Data="{StaticResource IconLock}" IsVisible="{Binding !IsPrivate}" />
                                                            <Path Classes="icon" Data="{StaticResource IconGlobe}" IsVisible="{Binding IsPrivate}" />
                                                        </Panel>
                                                    </Button>
                                                    <Button Classes="iconButton" Command="{Binding $parent[Window].((vm:OnlineExportViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="Delete from the cloud">
                                                        <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *" ColumnSpacing="20" Margin="0,16,0,0">
            <CheckBox Grid.Column="0" IsChecked="{Binding IncludeFolderInfo}" Content="Include Folder Information"
                      Foreground="{DynamicResource TextSecondary}" FontSize="12"
                      ToolTip.Tip="Uploads carry their folder path, and downloads rebuild it." />
            <CheckBox Grid.Column="1" IsChecked="{Binding UploadAsPrivate}" Content="Upload as Private"
                      Foreground="{DynamicResource TextSecondary}" FontSize="12"
                      ToolTip.Tip="Private uploads don't appear in community search. Use them to move sets and notes between your own devices." />
            <DockPanel Grid.Column="2" HorizontalAlignment="Right" Margin="16,0,0,0">
                <controls:BusySpinner DockPanel.Dock="Left" IsVisible="{Binding IsWorking}" Margin="0,0,8,0" />
                <TextBlock Classes="caption" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Grid>
    <!-- Overlay: pick the local set or note that overwrites a cloud copy. -->
    <Grid Background="{DynamicResource ScrimBackground}" IsVisible="{Binding IsSelectingUpdateDeck}">
        <Border Classes="card" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="600" Height="560">
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" RowSpacing="12">

                <TextBlock Grid.Row="0" Classes="title" Text="{Binding UpdateTitle}" HorizontalAlignment="Center" />

                <TextBlock Grid.Row="1" Classes="caption" Text="{Binding UpdateHint}"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <views:DeckFolderBrowserView Grid.Row="2" DataContext="{Binding UpdateBrowser}" />

                <TextBlock Grid.Row="3" Text="{Binding SelectedLocalItemForUpdate.Name, StringFormat='Selected: {0}', FallbackValue='Nothing selected'}" Classes="heading"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="16">
                    <Button Grid.Column="0" Classes="wide secondary" Content="Cancel" Command="{Binding CancelUpdateCommand}" />
                    <Button Grid.Column="1" Classes="wide primary" Content="Confirm Update" Command="{Binding ConfirmUpdateCommand}" />
                </Grid>
                
            </Grid>
        </Border>
    </Grid>
  </Grid>
</Window>