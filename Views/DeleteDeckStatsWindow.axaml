<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.DeleteDeckStatsWindow"
    x:DataType="vm:DeleteDeckStatsViewModel"
    Title="Delete Deck Stats"
    Width="520" Height="620" MinWidth="420" MinHeight="460"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" RowSpacing="12" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Delete Deck Stats" FontSize="24" FontWeight="Bold"
                Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Choose a set to clear its stats. Its cards are not affected. This cannot be undone."
                TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="10" Padding="12">
            <views:DeckFolderBrowserView DataContext="{Binding DeckBrowser}" />
        </Border>

        <TextBlock Grid.Row="2"
            Text="{Binding SelectedDeck.Name, StringFormat='Selected: {0}', FallbackValue='No deck selected'}"
            FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
            Foreground="{DynamicResource TextPrimary}" />

        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0" Content="Close" Click="Close_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                CornerRadius="8" Padding="12,10" FontWeight="SemiBold"
                Background="{DynamicResource CardBorder}" Foreground="{DynamicResource TextPrimary}"
                Cursor="Hand" />
            <Button Grid.Column="1" Content="Delete This Deck's Stats" Click="DeleteDeckStats_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                CornerRadius="8" Padding="12,10" FontWeight="Bold"
                IsEnabled="{Binding SelectedDeck, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource DangerBackground}" Foreground="{DynamicResource DangerBackgroundForeground}"
                Cursor="Hand" />
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
    </Grid>
</Window>
