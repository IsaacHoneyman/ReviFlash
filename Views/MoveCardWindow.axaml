<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.MoveCardWindow"
    x:DataType="vm:DeckFolderBrowser"
    Title="Move Card"
    Width="520" Height="620" MinWidth="420" MinHeight="460"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="12" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Move card to..." FontSize="24" FontWeight="Bold"
                Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Choose the set to move this card into. Its answer history goes with it."
                TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card compact" Padding="12">
            <views:DeckFolderBrowserView />
        </Border>

        <Button Grid.Row="2" Classes="wide secondary" Content="Cancel" Click="Cancel_Click" IsCancel="True" />
    </Grid>
</Window>
