<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.MoveCardWindow"
    x:DataType="vm:MoveCardViewModel"
    Title="Move or Copy Card"
    Width="520" Height="620" MinWidth="420" MinHeight="460"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="12" Margin="24">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Classes="title" Text="Move or Copy Card" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton Classes="dashboardToggle" Content="Move" IsChecked="{Binding IsMove, Mode=TwoWay}" />
                <ToggleButton Classes="dashboardToggle" Content="Copy" IsChecked="{Binding IsCopySelected, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding Hint}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card compact" Padding="12">
            <views:DeckFolderBrowserView DataContext="{Binding Browser}" />
        </Border>

        <Button Grid.Row="2" Classes="wide secondary" Content="Cancel" Click="Cancel_Click" IsCancel="True" />
    </Grid>
</Window>
