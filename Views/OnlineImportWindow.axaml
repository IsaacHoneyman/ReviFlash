<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReviFlash.ViewModels"
        xmlns:models="using:ReviFlash.Models"
        xmlns:onlineData="using:ReviFlash.Data.Online"
        x:Class="ReviFlash.Views.OnlineImportWindow"
        x:DataType="vm:OnlineImportViewModel"
        Title="Discover Flashcards"
        Width="760" Height="640" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
        
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="title" Text="Community Flashcards" />
                    <TextBlock Text="Search and download public flashcard sets created by other users."
                               Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding AccountText}" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"
                               ToolTip.Tip="Sign out from Settings."/>
                </StackPanel>
            </Grid>
            
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,8,0,0">
                <TextBox Grid.Column="0" Classes="input"
                         Text="{Binding SearchText}"
                         Watermark="Search by title, subject, or keywords..."
                         Height="40" VerticalContentAlignment="Center"
                         Padding="12,0"
                         Margin="0,0,12,0">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          CornerRadius="8" Width="180" Height="40" VerticalContentAlignment="Center" Margin="0,0,12,0"
                          Background="{DynamicResource CardBackground}" />

                <Button Grid.Column="2" Classes="primary"
                        Content="Search" 
                        Command="{Binding SearchCommand}"
                        Padding="16,0" Height="40" FontSize="14" FontWeight="SemiBold"
                        VerticalContentAlignment="Center" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Classes="card" CornerRadius="16" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="onlineData:FlashCardDeckMetadata">
                            <Border Classes="listRow" Padding="16" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="sectionTitle" Text="{Binding Title}" />
                                        <TextBlock Text="{Binding UploaderName, StringFormat='by {0}'}" IsVisible="{Binding HasUploaderName}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description, StringFormat='in {0}'}" IsVisible="{Binding HasDescription}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding CardCount, StringFormat='{}{0} cards'}" FontSize="12" Foreground="{DynamicResource GradientStart}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DownloadCountText}" FontSize="12" Foreground="{DynamicResource GradientStart}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="caption" Text="{Binding CreatedAt, StringFormat='{}{0:MMM dd, yyyy}'}" />
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" Classes="secondary"
                                            Command="{Binding $parent[Window].((vm:OnlineImportViewModel)DataContext).DownloadCommand}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"
                                            Padding="12,10"
                                            ToolTip.Tip="Download">
                                        <Path Classes="icon" Data="{StaticResource IconDownload}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,16,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="{Binding TargetFolderText}" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding IncludeFolderInfo}" Content="Recreate uploader's folders"
                          Foreground="{DynamicResource TextSecondary}" FontSize="13"
                          ToolTip.Tip="If the uploader included folder information, rebuild their folders inside the one you're saving to." />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
        </Grid>
    </Grid>
</Window>