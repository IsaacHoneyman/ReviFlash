<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ReviFlash.Views.Controls"
        xmlns:vm="using:ReviFlash.ViewModels"
        xmlns:models="using:ReviFlash.Models"
        xmlns:onlineData="using:ReviFlash.Data.Online"
        x:Class="ReviFlash.Views.OnlineImportWindow"
        x:DataType="vm:OnlineImportViewModel"
        Title="Community"
        Width="760" Height="640" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
        
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="title" Text="Community" />
                    <TextBlock Classes="caption" Text="Search and download public sets and notes shared by other users."
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                    <controls:SegmentedSwitch FirstLabel="Sets" SecondLabel="Notes" IsSecond="{Binding ShowNotes}" />
                    <TextBlock Classes="caption" Text="{Binding AccountText}" Margin="8,0,0,0" VerticalAlignment="Center"
                               ToolTip.Tip="Sign out from Settings."/>
                </StackPanel>
            </Grid>
            
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,8,0,0">
                <TextBox Grid.Column="0" Classes="input"
                         Text="{Binding SearchText}"
                         Watermark="{Binding SearchWatermark}"
                         Height="40" VerticalContentAlignment="Center"
                         Padding="12,0"
                         Margin="0,0,12,0">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          CornerRadius="8" Width="180" Height="40" VerticalContentAlignment="Center" Margin="0,0,12,0"
                          Background="{DynamicResource CardBackground}" />

                <Button Grid.Column="2" Classes="primary"
                        Content="Search" 
                        Command="{Binding SearchCommand}"
                        Padding="16,0" Height="40"
                        VerticalContentAlignment="Center" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Classes="card" CornerRadius="16" Padding="16">
          <Panel>
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSearching}">
                <controls:BusySpinner Classes="large" IsVisible="{Binding IsSearching}" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="Searching..." HorizontalAlignment="Center" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="onlineData:FlashCardDeckMetadata">
                            <Border Classes="listRow" Padding="16" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="sectionTitle" Text="{Binding Title}" />
                                        <TextBlock Classes="caption" Text="{Binding UploaderName, StringFormat='by {0}'}" IsVisible="{Binding HasUploaderName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Classes="caption" Text="{Binding Description, StringFormat='in {0}'}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                                            <TextBlock Classes="caption accent" Text="{Binding SizeText}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="caption accent" Text="{Binding DownloadCountText}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="caption" Text="{Binding CreatedAt, StringFormat='{}{0:d MMM yyyy}'}" />
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" Classes="secondary"
                                            Command="{Binding $parent[Window].((vm:OnlineImportViewModel)DataContext).DownloadCommand}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"
                                            Padding="12,10"
                                            ToolTip.Tip="Download">
                                        <Path Classes="icon" Data="{StaticResource IconDownload}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,16,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{Binding TargetFolderText}" VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding IncludeFolderInfo}" Content="Recreate Uploader's Folders"
                          Foreground="{DynamicResource TextSecondary}" FontSize="12"
                          ToolTip.Tip="If the uploader included folder information, rebuild their folders inside the one you're saving to." />
            </StackPanel>
            <DockPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                <!-- A search already shows its spinner over the results. -->
                <controls:BusySpinner DockPanel.Dock="Left" Margin="0,0,8,0">
                    <controls:BusySpinner.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsWorking" />
                            <Binding Path="!IsSearching" />
                        </MultiBinding>
                    </controls:BusySpinner.IsVisible>
                </controls:BusySpinner>
                <TextBlock Classes="caption" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>