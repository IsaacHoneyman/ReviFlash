<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:controls="using:ReviFlash.Views.Controls"
    xmlns:views="using:ReviFlash.Views"
    x:Class="ReviFlash.Views.ThemePickerView"
    x:DataType="vm:ThemePickerViewModel"
    Background="{DynamicResource AppBackground}">

    <UserControl.Styles>
        <Style Selector="Button.swatch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.swatchFrame">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.swatchFrame.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Border.swatchFrame.newTheme">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBackground}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>

    </UserControl.Styles>

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://ReviFlash/Views/Controls/LibraryCard.axaml" />
        </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="SwatchTile" x:DataType="vm:ThemeSwatch">
            <Button Classes="swatch" Width="120" Margin="0,0,6,6"
                Command="{Binding $parent[views:ThemePickerView].((vm:ThemePickerViewModel)DataContext).SelectCommand}"
                CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                <StackPanel Spacing="6">
                    <Border Classes="swatchFrame" Classes.selected="{Binding IsSelected}" Background="{Binding Background}">
                        <Border Background="{Binding Card}" BorderBrush="{Binding Group}" BorderThickness="1.5" CornerRadius="6" Padding="6">
                            <Grid RowDefinitions="*, Auto">
                                <Border Grid.Row="0" Background="{Binding Text}" Height="4" Width="40" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                    <Ellipse Classes="dot" Fill="{Binding Group}" />
                                    <Ellipse Classes="dot" Fill="{Binding Folder}" />
                                    <Ellipse Classes="dot" Fill="{Binding Note}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                    <TextBlock Classes="caption" Text="{Binding Name}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The themes and the editor on the left; a preview of the app in the chosen theme on the right. -->
    <Grid ColumnDefinitions="*, 440">
    <ScrollViewer Margin="32,24,8,24" Padding="0,0,24,0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Classes="secondary" Content="← Back" Click="Back_Click" Height="38" Padding="12,0"
                        VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Back (Esc)" />
                    <TextBlock Classes="title" Text="Themes" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                    Text="Pick a theme to use it straight away, or make your own below." />
            </StackPanel>

            <TextBlock Classes="sectionTitle" Text="Built-in Themes" />
            <ItemsControl x:Name="BuiltInList" ItemsSource="{Binding BuiltInSwatches}" ItemTemplate="{StaticResource SwatchTile}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="Your Themes" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding SavedThemesHint}" />
            </StackPanel>
            <WrapPanel>
                <ItemsControl x:Name="SavedList" ItemsSource="{Binding SavedSwatches}" ItemTemplate="{StaticResource SwatchTile}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Classes="swatch" Width="120" Margin="0,0,6,6" Command="{Binding NewThemeCommand}"
                    ToolTip.Tip="Make a new theme of your own">
                    <StackPanel Spacing="6">
                        <Border Classes="swatchFrame newTheme">
                            <TextBlock Text="+" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                        <TextBlock Classes="caption" Text="New Theme" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Border Classes="card compact" IsVisible="{Binding ShowEditor}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <TextBox Grid.Column="0" Classes="input" Text="{Binding ThemeName}" MaxLength="30"
                            FontSize="18" FontWeight="Bold" Watermark="Theme name" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="iconButton" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate theme" VerticalAlignment="Center">
                                <Path Classes="icon" Data="{StaticResource IconCopy}" />
                            </Button>
                            <Button Classes="iconButton" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete theme" VerticalAlignment="Center">
                                <Path Classes="icon danger" Data="{StaticResource IconDelete}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="error" Text="{Binding NameProblem}"
                        IsVisible="{Binding NameProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                        Text="Pick a background and two accents. ReviFlash works out the rest, keeping text and badges readable. Changes save as you go." />

                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="8" ColumnSpacing="16">
                        <TextBlock Grid.Row="0" Classes="body" Text="Background" VerticalAlignment="Center" />
                        <ColorPicker Grid.Row="0" Grid.Column="1" Color="{Binding BackgroundColour}" IsAlphaEnabled="False" IsAlphaVisible="False" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Classes="body" Text="Accent" VerticalAlignment="Center" />
                        <ColorPicker Grid.Row="1" Grid.Column="1" Color="{Binding AccentColour}" IsAlphaEnabled="False" IsAlphaVisible="False" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="2" Classes="body" Text="Second Accent" VerticalAlignment="Center" />
                        <ColorPicker Grid.Row="2" Grid.Column="1" Color="{Binding SecondAccentColour}" IsAlphaEnabled="False" IsAlphaVisible="False" HorizontalAlignment="Left" />
                    </Grid>


                    <TextBlock Classes="error" Text="{Binding ReadabilityWarning}"
                        IsVisible="{Binding ReadabilityWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <ToggleButton x:Name="AdvancedToggle" Classes="dashboardToggle" Content="Change Any Colour" HorizontalAlignment="Left" />
                    <StackPanel Spacing="8" IsVisible="{Binding #AdvancedToggle.IsChecked}">
                        <ItemsControl ItemsSource="{Binding ColourEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeColourEntry">
                                    <Grid ColumnDefinitions="*, Auto, 72" ColumnSpacing="12" Margin="0,0,0,6">
                                        <TextBlock Grid.Column="0" Classes="body" Text="{Binding Label}" VerticalAlignment="Center" />
                                        <ColorPicker Grid.Column="1" Color="{Binding Colour}" IsAlphaEnabled="False" IsAlphaVisible="False" />
                                        <Button Grid.Column="2" Classes="secondary" Content="Reset" IsVisible="{Binding IsOverridden}"
                                            Command="{Binding $parent[ItemsControl].((vm:ThemePickerViewModel)DataContext).ResetColourCommand}"
                                            CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="secondary" Content="Reset All Colours" HorizontalAlignment="Left"
                            Command="{Binding ResetAllColoursCommand}" IsVisible="{Binding HasOverrides}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0" Padding="28,24,28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Real pieces of the app, drawn in the theme in use; not clickable. -->
            <StackPanel Spacing="18" IsHitTestVisible="False">
                <TextBlock Classes="label" Text="PREVIEW" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="ReviFlash" FontFamily="{DynamicResource SerifFont}" FontSize="24" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}" />
                    <Button Classes="primary" Content="+ New" Height="34" Padding="14,0" VerticalContentAlignment="Center" />
                </StackPanel>

                <controls:LibraryCard Classes="folder" Title="Year 2" Icon="{StaticResource IconFolder}" Focusable="False" Width="380" Margin="0">
                    <controls:LibraryCard.Badge>
                        <TextBlock Classes="caption" Text="9 items" />
                    </controls:LibraryCard.Badge>
                </controls:LibraryCard>
                <controls:LibraryCard Title="Linear Algebra" Focusable="False" Width="380" Margin="0">
                    <controls:LibraryCard.Badge>
                        <TextBlock Classes="caption" Text="24 cards" />
                    </controls:LibraryCard.Badge>
                    <TextBlock Classes="caption cardHint" Text="Studied 3 days ago" />
                </controls:LibraryCard>

                <!-- A card as it reads in a review -->
                <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="20,18">
                    <StackPanel Spacing="12">
                        <Border Height="3" CornerRadius="2" Background="{DynamicResource StatTileBackground}">
                            <Border Width="140" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource GradientStart}" />
                        </Border>
                        <TextBlock Text="What is the determinant of a 2 × 2 matrix?" FontFamily="{DynamicResource SerifFont}" FontSize="19"
                            TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                        <Border Width="48" Height="1.5" HorizontalAlignment="Left" Background="{DynamicResource GroupCardBorder}" />
                        <TextBlock Text="ad − bc. If it's zero, the matrix has no inverse." FontFamily="{DynamicResource SerifFont}" FontSize="16"
                            TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Opacity="0.92" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Classes="secondary" Content="Incorrect" Height="36" Padding="16,0" VerticalContentAlignment="Center" />
                            <Button Content="Correct" Height="36" Padding="16,0" VerticalContentAlignment="Center"
                                Background="{DynamicResource TextPrimary}" Foreground="{DynamicResource AppBackground}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Classes="caption" Text="✓ Correct" Foreground="{DynamicResource SuccessForeground}" />
                            <TextBlock Classes="caption" Text="✕ Incorrect" Foreground="{DynamicResource DangerForeground}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10">
                    <TextBox Classes="input" Text="Search sets, notes, groups…" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox IsChecked="True" Content="A setting" />
                        <CheckBox IsChecked="False" Content="Another" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="Secondary" Height="34" Padding="14,0" VerticalContentAlignment="Center" />
                        <Button Classes="danger" Content="Delete" Height="34" Padding="14,0" VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Classes="body secondary" Text="Accuracy Rate" />
                        <TextBlock Grid.Column="1" Classes="body" Text="94.2%" FontFamily="{DynamicResource MonoFont}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
    </Grid>
</UserControl>
