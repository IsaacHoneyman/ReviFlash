<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ReviFlash.Models"
    xmlns:controls="using:ReviFlash.Views.Controls"
    x:Class="ReviFlash.Views.Controls.BreadcrumbBar">

    <UserControl.Styles>
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto, *">
        <Button Grid.Column="0" Classes="secondary"
            Click="Up_Click"
            Content="← Back"
            Padding="10,6" FontSize="13" Margin="0,0,12,0"
            ToolTip.Tip="Back to the parent folder" />

        <ScrollViewer Grid.Column="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="crumb" Click="Crumb_Click"
                    Content="Main Menu"
                    Foreground="{DynamicResource TextSecondary}" />

                <ItemsControl ItemsSource="{Binding $parent[controls:BreadcrumbBar].Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Folder">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="/" FontSize="13" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <Button Classes="crumb" Click="Crumb_Click" Content="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
