<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ReviFlash.ViewModels"
    xmlns:models="using:ReviFlash.Models"
    xmlns:controls="using:ReviFlash.Views.Controls"
    x:Class="ReviFlash.Views.DeckFolderBrowserView"
    x:DataType="vm:DeckFolderBrowser">

    <!-- Folder-aware deck picker: search + sort, breadcrumb trail, then folders and sets. -->
    <Grid RowDefinitions="Auto, Auto, *" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0"
                Text="{Binding SearchText, Mode=TwoWay}"
                Watermark="{Binding SearchWatermark}"
                Classes="input" Height="36" VerticalContentAlignment="Center" Padding="10,0"
                Background="{DynamicResource AppBackground}" />

            <ComboBox Grid.Column="1"
                IsVisible="{Binding ShowSortOptions}"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}"
                CornerRadius="8" Width="180" Height="36" VerticalContentAlignment="Center"
                Background="{DynamicResource AppBackground}" />
        </Grid>

        <controls:BreadcrumbBar Grid.Row="1"
            Breadcrumbs="{Binding Breadcrumbs}"
            IsVisible="{Binding IsInFolder}"
            UpRequested="Breadcrumbs_UpRequested"
            CrumbRequested="Breadcrumbs_CrumbRequested" />

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding EmptyStateText}"
                IsVisible="{Binding HasNoItems}"
                HorizontalAlignment="Center" Margin="0,24,0,0"
                TextWrapping="Wrap" TextAlignment="Center"
                Foreground="{DynamicResource TextSecondary}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="0,0,-16,0" Padding="0,0,16,0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.DataTemplates>

                        <!-- Folder: the whole row opens it. -->
                        <DataTemplate DataType="models:Folder">
                            <Button Command="{Binding $parent[UserControl].((vm:DeckFolderBrowser)DataContext).OpenFolderCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="#14000000"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Margin="0,0,0,10"
                                Cursor="Hand" ToolTip.Tip="Open folder">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Path Grid.Column="0" Classes="icon medium" Data="{StaticResource IconFolder}"
                                        VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Classes="caption" Text="{Binding ContentsSummary}" />
                                        <TextBlock Classes="hint" Text="{Binding FolderPath, StringFormat='in {0}'}"
                                            IsVisible="{Binding HasFolderPath}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="›" FontSize="22"
                                        VerticalAlignment="Center" Margin="12,0,4,0"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                            </Button>
                        </DataTemplate>

                        <!-- Set: the action button's text and command come from the host. -->
                        <DataTemplate DataType="models:FlashCardDeck">
                            <Border Classes="listRow">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Classes="caption" Text="{Binding CardCount, StringFormat='{}{0} cards'}" />
                                        <TextBlock Classes="hint" Text="{Binding FolderPath, StringFormat='in {0}'}"
                                            IsVisible="{Binding HasFolderPath}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Classes="primary"
                                        Content="{Binding $parent[UserControl].((vm:DeckFolderBrowser)DataContext).ActionText}"
                                        Command="{Binding $parent[UserControl].((vm:DeckFolderBrowser)DataContext).DeckActionCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center"
                                        Padding="14,8" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
