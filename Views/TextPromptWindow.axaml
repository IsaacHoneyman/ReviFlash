<controls:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ReviFlash.Views.Controls"
        x:Class="ReviFlash.Views.TextPromptWindow"
        Title="ReviFlash"
        Width="460" Height="230">

    <Border Classes="dialogShell">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <TextBlock x:Name="PromptText"
                Grid.Row="0"
                Classes="sectionTitle"
                Text="Folder name"
                TextWrapping="Wrap" />

            <TextBox x:Name="InputBox"
                Grid.Row="1"
                Classes="input"
                Margin="0,16,0,0"
                Padding="10,8"
                FontSize="15"
                KeyDown="Input_KeyDown" />

            <TextBlock x:Name="HintText"
                Grid.Row="2"
                Classes="caption"
                Margin="0,10,0,0"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Classes="dialog secondary" Click="Cancel_Click" Content="Cancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Classes="dialog primary" Click="Confirm_Click" Content="Create" />
            </StackPanel>
        </Grid>
    </Border>
</controls:DialogWindow>
