<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReviFlash.Views.TextPromptWindow"
        Title="ReviFlash"
        Width="460" Height="230"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Border Background="{DynamicResource AppBackground}"
        Opacity="0.98"
        BorderBrush="{DynamicResource CardBorder}"
        BorderThickness="2"
        CornerRadius="20"
        Padding="24">

        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <TextBlock x:Name="PromptText"
                Grid.Row="0"
                Text="Folder name"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimary}"
                TextWrapping="Wrap" />

            <TextBox x:Name="InputBox"
                Grid.Row="1"
                Margin="0,16,0,0"
                CornerRadius="8"
                Padding="10,8"
                FontSize="15"
                KeyDown="Input_KeyDown"
                Background="{DynamicResource CardBackground}"
                Foreground="{DynamicResource TextPrimary}" />

            <TextBlock x:Name="HintText"
                Grid.Row="2"
                Margin="0,10,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextSecondary}"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Click="Cancel_Click" Content="Cancel"
                    Background="#70FFFFFF"
                    Foreground="{DynamicResource TextPrimary}"
                    CornerRadius="8" Padding="20,10" FontWeight="SemiBold" Cursor="Hand" />

                <Button x:Name="ConfirmButton" Click="Confirm_Click" Content="Create"
                    Background="{DynamicResource GradientStart}"
                    Foreground="{DynamicResource PrimaryButtonForeground}"
                    CornerRadius="8" Padding="20,10" FontWeight="Bold" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
