<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Keep every glyph inside the 17x17 live area centred on (12,12) of a 24x24 grid, since Stretch="Uniform" fits each Path to its ink bounds. -->

    <StreamGeometry x:Key="IconItalic">M10 4 L 19 4 M5 20 L 14 20 M14.5 4 L 9.5 20</StreamGeometry>
    <StreamGeometry x:Key="IconEdit">M17.96 3.56 A 1.75 1.75 0 0 1 20.44 6.04 L 8.04 18.44 L 3.5 20.5 L 5.56 15.96 Z M14.96 6.56 L 17.44 9.04</StreamGeometry>

    <StreamGeometry x:Key="IconStats">M3.5 20.5 L 20.5 20.5 M7.5 20.5 L 7.5 13 M12 20.5 L 12 8 M16.5 20.5 L 16.5 3.5</StreamGeometry>


    <StreamGeometry x:Key="IconDelete">M3.5 6.9 L 20.5 6.9 M9.1 6.9 L 9.1 5.2 A 1.3 1.3 0 0 1 10.4 3.9 L 13.6 3.9 A 1.3 1.3 0 0 1 14.9 5.2 L 14.9 6.9 M5.7 6.9 L 6.7 18.9 A 1.8 1.8 0 0 0 8.5 20.5 L 15.5 20.5 A 1.8 1.8 0 0 0 17.3 18.9 L 18.3 6.9 M10.2 10.8 L 10.2 16.8 M13.8 10.8 L 13.8 16.8</StreamGeometry>

    <StreamGeometry x:Key="IconFolder">M3.5 17.4 L 3.5 6.6 A 1.6 1.6 0 0 1 5.1 5 L 8.5 5 L 10.6 7.5 L 18.9 7.5 A 1.6 1.6 0 0 1 20.5 9.1 L 20.5 17.4 A 1.6 1.6 0 0 1 18.9 19 L 5.1 19 A 1.6 1.6 0 0 1 3.5 17.4 Z</StreamGeometry>

    <StreamGeometry x:Key="IconSettings">M5.6 3.5 L 5.6 7.5 M5.6 11.7 L 5.6 20.5 M12 3.5 L 12 12.5 M12 16.7 L 12 20.5 M18.4 3.5 L 18.4 5.3 M18.4 9.5 L 18.4 20.5 M3.5 9.6 A 2.1 2.1 0 1 0 7.7 9.6 A 2.1 2.1 0 1 0 3.5 9.6 Z M9.9 14.6 A 2.1 2.1 0 1 0 14.1 14.6 A 2.1 2.1 0 1 0 9.9 14.6 Z M16.3 7.4 A 2.1 2.1 0 1 0 20.5 7.4 A 2.1 2.1 0 1 0 16.3 7.4 Z</StreamGeometry>

    <!-- Cloud deck actions: arrow into a tray (download), out of one (update/upload). -->
    <StreamGeometry x:Key="IconDownload">M12 3.5 L 12 14.5 M7.5 10 L 12 14.5 L 16.5 10 M3.5 15.5 L 3.5 18.9 A 1.6 1.6 0 0 0 5.1 20.5 L 18.9 20.5 A 1.6 1.6 0 0 0 20.5 18.9 L 20.5 15.5</StreamGeometry>

    <StreamGeometry x:Key="IconUpload">M12 14.5 L 12 3.5 M7.5 8 L 12 3.5 L 16.5 8 M3.5 15.5 L 3.5 18.9 A 1.6 1.6 0 0 0 5.1 20.5 L 18.9 20.5 A 1.6 1.6 0 0 0 20.5 18.9 L 20.5 15.5</StreamGeometry>

    <!-- Visibility: padlock (make private) and globe (make public). Both span the full width. -->
    <StreamGeometry x:Key="IconLock">M3.5 11.6 A 1.6 1.6 0 0 1 5.1 10 L 18.9 10 A 1.6 1.6 0 0 1 20.5 11.6 L 20.5 18.9 A 1.6 1.6 0 0 1 18.9 20.5 L 5.1 20.5 A 1.6 1.6 0 0 1 3.5 18.9 Z M7.5 10 L 7.5 8 A 4.5 4.5 0 0 1 16.5 8 L 16.5 10 M12 14 L 12 16.5</StreamGeometry>

    <StreamGeometry x:Key="IconGlobe">M3.5 12 A 8.5 8.5 0 1 0 20.5 12 A 8.5 8.5 0 1 0 3.5 12 Z M3.5 12 L 20.5 12 M12 3.5 A 4 8.5 0 0 1 12 20.5 A 4 8.5 0 0 1 12 3.5 Z</StreamGeometry>

    <StreamGeometry x:Key="IconClose">M5.5 5.5 L 18.5 18.5 M18.5 5.5 L 5.5 18.5</StreamGeometry>

    <StreamGeometry x:Key="IconPlus">M12 3.5 L 12 20.5 M3.5 12 L 20.5 12</StreamGeometry>

    <!-- Help: a question mark in a circle. -->
    <StreamGeometry x:Key="IconHelp">M3.5 12 A 8.5 8.5 0 1 0 20.5 12 A 8.5 8.5 0 1 0 3.5 12 Z M9.6 9.7 A 2.5 2.5 0 1 1 13.1 12 C 12.4 12.4 12 12.9 12 13.8 M12 16.8 L 12 16.9</StreamGeometry>

    <StreamGeometry x:Key="IconCheck">M3.5 12.5 L 9 18 L 20.5 6</StreamGeometry>

    <StreamGeometry x:Key="IconLeftRight">M3.5 12 L 20.5 12 M7.5 8 L 3.5 12 L 7.5 16 M16.5 8 L 20.5 12 L 16.5 16</StreamGeometry>

    <StreamGeometry x:Key="IconCopy">M9 18.9 L 9 10.2 A 1.6 1.6 0 0 1 10.6 8.6 L 18.9 8.6 A 1.6 1.6 0 0 1 20.5 10.2 L 20.5 18.9 A 1.6 1.6 0 0 1 18.9 20.5 L 10.6 20.5 A 1.6 1.6 0 0 1 9 18.9 Z M6 15.4 L 5.1 15.4 A 1.6 1.6 0 0 1 3.5 13.8 L 3.5 5.1 A 1.6 1.6 0 0 1 5.1 3.5 L 13.4 3.5 A 1.6 1.6 0 0 1 15 5.1 L 15 6</StreamGeometry>

</ResourceDictionary>
