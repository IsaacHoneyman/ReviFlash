<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styles for Icons.axaml; size is set per class and stroke weight rises with it so large icons don't read thin. -->

    <!-- Width only, so Stretch="Uniform" keeps each glyph's aspect ratio and wide ones like the folder centre in their parent. -->
    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Destructive actions carry the only colour in the set. -->
    <Style Selector="Path.icon.danger">
        <Setter Property="Stroke" Value="{DynamicResource DangerForeground}" />
    </Style>

    <!-- Lead icon beside a card title. -->
    <Style Selector="Path.icon.medium">
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Width" Value="21" />
    </Style>

    <!-- Toolbar scale, e.g. the settings button. -->
    <Style Selector="Path.icon.large">
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Width" Value="22" />
    </Style>

    <!-- Card editor actions, which sit on larger buttons than the dashboard cards. -->
    <Style Selector="Path.icon.editorAction">
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="Width" Value="17" />
    </Style>

</Styles>
