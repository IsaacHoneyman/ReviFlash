            <SolidColorBrush x:Key="NoteCardBorder" Color="#AAD969" />
            <SolidColorBrush x:Key="NoteBadgeForeground" Color="#0F1722" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#20334A" />
            <SolidColorBrush x:Key="StatTileBackground" Color="#1D2E42" />
            <SolidColorBrush x:Key="TextPrimary" Color="#E3F2FD" />
            <SolidColorBrush x:Key="TextSecondary" Color="#90CAF9" />
