        <ResourceDictionary x:Key="{x:Static local:AppThemes.Amethyst}">
            <SolidColorBrush x:Key="AppBackground" Color="#140F24" />

            <SolidColorBrush x:Key="CardBackground" Color="#221A36" />
            <SolidColorBrush x:Key="CardBorder" Color="#5A4A8D" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#8F6ED5" />
            <SolidColorBrush x:Key="FolderCardBorder" Color="#CED56E" />
            <SolidColorBrush x:Key="GroupBadgeForeground" Color="#140F24" />
            <SolidColorBrush x:Key="FolderBadgeForeground" Color="#140F24" />
            <SolidColorBrush x:Key="NoteCardBorder" Color="#6ED5B3" />
            <SolidColorBrush x:Key="NoteBadgeForeground" Color="#140F24" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#3A2E62" />
