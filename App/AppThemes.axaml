        <!--  Test Themes -->
        

        <ResourceDictionary x:Key="{x:Static local:AppThemes.Graphite}">
            <SolidColorBrush x:Key="AppBackground" Color="#0F1012" />
            <SolidColorBrush x:Key="CardBackground" Color="#181A1D" />
            <SolidColorBrush x:Key="CardBorder" Color="#363A40" />
