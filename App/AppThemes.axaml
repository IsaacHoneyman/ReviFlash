            <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#FDF0D5" />
            <SolidColorBrush x:Key="IconForeground" Color="#E0A96D" />
            <Color x:Key="GradientStart">#8C5830</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="{x:Static local:AppThemes.Nordic}">
            <SolidColorBrush x:Key="AppBackground" Color="#0F1722" />
            <SolidColorBrush x:Key="CardBackground" Color="#182433" />
            <SolidColorBrush x:Key="CardBorder" Color="#314B6B" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#5CE1E6" />
            <SolidColorBrush x:Key="FolderCardBorder" Color="#E55D7A" />
            <SolidColorBrush x:Key="GroupBadgeForeground" Color="#0F1722" />
