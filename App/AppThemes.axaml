        </ResourceDictionary>

        <ResourceDictionary x:Key="{x:Static local:AppThemes.Sakura}">
            <SolidColorBrush x:Key="AppBackground" Color="#1E1418" />
            <SolidColorBrush x:Key="CardBackground" Color="#2C1D24" />
            <SolidColorBrush x:Key="CardBorder" Color="#663D4F" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#FFB7C5" />
            <SolidColorBrush x:Key="FolderCardBorder" Color="#C1F5DE" />
            <SolidColorBrush x:Key="GroupBadgeForeground" Color="#1E1418" />
