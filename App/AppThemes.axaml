            <SolidColorBrush x:Key="CardBackground" Color="#121417" />
            <SolidColorBrush x:Key="CardBorder" Color="#24323A" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#3FB7C1" />
            <SolidColorBrush x:Key="FolderCardBorder" Color="#C13F56" />
            <SolidColorBrush x:Key="GroupBadgeForeground" Color="#0B0E12" />
            <SolidColorBrush x:Key="FolderBadgeForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NoteCardBorder" Color="#8BC13F" />
