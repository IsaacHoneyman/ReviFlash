<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReviFlash">

    <SolidColorBrush x:Key="SurfaceActionForeground" Color="#0D1620" />
    <ResourceDictionary.ThemeDictionaries>

        <!-- The default: warm charcoal, off-white text and one amber accent. -->
        <ResourceDictionary x:Key="{x:Static local:AppThemes.Ink}">
            <SolidColorBrush x:Key="AppBackground" Color="#18181A" />

            <SolidColorBrush x:Key="CardBackground" Color="#29292D" />
            <SolidColorBrush x:Key="CardBorder" Color="#38383E" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#C98A6B" />
            <SolidColorBrush x:Key="FolderCardBorder" Color="#E8B48A" />
            <SolidColorBrush x:Key="GroupBadgeForeground" Color="#18181A" />
            <SolidColorBrush x:Key="FolderBadgeForeground" Color="#18181A" />
            <SolidColorBrush x:Key="NoteCardBorder" Color="#8FA9C8" />
            <SolidColorBrush x:Key="NoteBadgeForeground" Color="#18181A" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#34343A" />
            <SolidColorBrush x:Key="StatTileBackground" Color="#1F1F22" />

            <SolidColorBrush x:Key="TextPrimary" Color="#ECE8DF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A39F95" />
            <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#1B1609" />
            <SolidColorBrush x:Key="SurfaceActionForeground" Color="#18181A" />
            <SolidColorBrush x:Key="IconForeground" Color="#C9C5BC" />

            <Color x:Key="GradientStart">#E9B261</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="{x:Static local:AppThemes.Crimson}">
            <SolidColorBrush x:Key="AppBackground" Color="#150C0D" />

            <SolidColorBrush x:Key="CardBackground" Color="#24171A" />
            <SolidColorBrush x:Key="CardBorder" Color="#3A2629" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#E0705F" />
            <SolidColorBrush x:Key="FolderCardBorder" Color="#C9A9A5" />
            <SolidColorBrush x:Key="GroupBadgeForeground" Color="#150C0D" />
            <SolidColorBrush x:Key="FolderBadgeForeground" Color="#150C0D" />
            <SolidColorBrush x:Key="NoteCardBorder" Color="#D99A8F" />
            <SolidColorBrush x:Key="NoteBadgeForeground" Color="#150C0D" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#3A2629" />
            <SolidColorBrush x:Key="StatTileBackground" Color="#1C1113" />

            <SolidColorBrush x:Key="TextPrimary" Color="#F6ECEA" />
            <SolidColorBrush x:Key="TextSecondary" Color="#C7A6A1" />
            <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#150C0D" />
            <SolidColorBrush x:Key="SurfaceActionForeground" Color="#150C0D" />
            <SolidColorBrush x:Key="IconForeground" Color="#E3CFCB" />

            <Color x:Key="GradientStart">#E06A5A</Color>
        </ResourceDictionary>


        <ResourceDictionary x:Key="{x:Static local:AppThemes.Forest}">
            <SolidColorBrush x:Key="AppBackground" Color="#0D1A14" />

            <SolidColorBrush x:Key="CardBackground" Color="#1A2A21" />
            <SolidColorBrush x:Key="CardBorder" Color="#3D6B54" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#90BE6D" />
            <SolidColorBrush x:Key="FolderCardBorder" Color="#876DBE" />
            <SolidColorBrush x:Key="GroupBadgeForeground" Color="#0D1A14" />
            <SolidColorBrush x:Key="FolderBadgeForeground" Color="#000000" />
            <SolidColorBrush x:Key="NoteCardBorder" Color="#BE6D74" />
            <SolidColorBrush x:Key="NoteBadgeForeground" Color="#0D1A14" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#2A4A3A" />
            <SolidColorBrush x:Key="StatTileBackground" Color="#263F33" />

            <SolidColorBrush x:Key="TextPrimary" Color="#F0FFF5" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A7D1B8" />
            <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#F0FFF5" />
