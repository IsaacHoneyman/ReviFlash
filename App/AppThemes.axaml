            <SolidColorBrush x:Key="TextSecondary" Color="#C8BEE8" />
            <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#F7F3FF" />
            <SolidColorBrush x:Key="SurfaceActionForeground" Color="#0D1620" />
            <SolidColorBrush x:Key="IconForeground" Color="#F7F3FF" />

            <Color x:Key="GradientStart">#5A3E9B</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="{x:Static local:AppThemes.Coffee}">
            <SolidColorBrush x:Key="AppBackground" Color="#211713" />
            <SolidColorBrush x:Key="CardBackground" Color="#30231D" />
            <SolidColorBrush x:Key="CardBorder" Color="#5C4438" />
            <SolidColorBrush x:Key="GroupCardBorder" Color="#D4A373" />
