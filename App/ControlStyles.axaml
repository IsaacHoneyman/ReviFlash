<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ReviFlash.Views.Controls">

    <!-- Shared control looks, opted into by class. -->

    <!-- Buttons -->

    <Style Selector="Button.primary, Button.secondary, Button.danger, Button.success">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource GradientStart}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource StatTileBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBackgroundForeground}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBackground}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Keep each button's own colours on hover and press (Fluent would turn them all grey) and just lighten a little. -->
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.success:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.primary:pointerover, Button.secondary:pointerover, Button.danger:pointerover, Button.success:pointerover">
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <!-- Dialog footer buttons, e.g. Cancel beside the confirming action. -->
    <Style Selector="Button.dialog">
        <Setter Property="Padding" Value="20,10" />
    </Style>

    <!-- Full-width buttons, alone or sharing a row. -->
    <Style Selector="Button.wide">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Large keyboard-driven buttons (review and its summary). Not focusable, so focus never wanders onto one. -->
    <Style Selector="Button.action">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Small square icon buttons on cards and list rows. -->
    <Style Selector="Button.iconButton">
        <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton.dashboardToggle">
        <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.dashboardToggle:checked">
        <Setter Property="Background" Value="{DynamicResource GradientStart}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
    </Style>
    <!-- Fluent paints a checked toggle's inner presenter in its own accent blue; this keeps it in the theme's colour. -->
    <Style Selector="ToggleButton.dashboardToggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.dashboardToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.dashboardToggle:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GradientStart}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}" />
    </Style>

    <!-- Surfaces -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.card.compact">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- One item in a list inside a card. -->
    <Style Selector="Border.listRow">
        <Setter Property="Background" Value="#14000000" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- The whole visible body of a chromeless dialog (see DialogWindow). -->
    <Style Selector="Border.dialogShell">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Opacity" Value="0.96" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- Inputs -->

    <Style Selector="TextBox.input">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Text: the app's type scale. Views use these classes rather than setting FontSize themselves. -->

    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- A window's or dialog's heading. -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- A card's heading. -->
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
    </Style>

    <!-- Colour classes go after the type scale so they win over it; a colour set inline inside a template loses to any style. -->
    <Style Selector="TextBlock.primary">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource GradientStart}" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForeground}" />
    </Style>

    <!-- Library card text: the count in its badge, then the hint lines under the name. -->
    <Style Selector="TextBlock.badgeCount">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.folderBadge">
        <Setter Property="Foreground" Value="{DynamicResource FolderBadgeForeground}" />
    </Style>
    <Style Selector="TextBlock.groupBadge">
        <Setter Property="Foreground" Value="{DynamicResource GroupBadgeForeground}" />
    </Style>
    <Style Selector="TextBlock.noteBadge">
        <Setter Property="Foreground" Value="{DynamicResource NoteBadgeForeground}" />
    </Style>
    <Style Selector="TextBlock.badgeLabel">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.cardHint">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Keyboard focus ring (Tab and arrow keys, never mouse clicks), which Fluent doesn't draw for these controls. -->
    <Style Selector="Button, ToggleButton, ComboBox">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="2" BorderBrush="{DynamicResource TextPrimary}"
                    CornerRadius="{ReflectionBinding Path=(AdornerLayer.AdornedElement).CornerRadius, RelativeSource={RelativeSource Self}}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox, RadioButton, ToggleSwitch, Slider, ListBoxItem, TabItem">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="6" BorderThickness="2"
                    BorderBrush="{DynamicResource TextPrimary}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|SegmentedSwitch">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource TextPrimary}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- Library cards: the keyboard highlight follows the card's rounded corners. -->
    <Style Selector="controls|LibraryCard">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="20" BorderThickness="2"
                    BorderBrush="{DynamicResource TextPrimary}" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- Progress bars fill in the theme's colour rather than Fluent's blue. -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource GradientStart}" />
    </Style>

    <!-- Busy spinner (BusySpinner control), which turns itself on the render thread. -->

    <Style Selector="Arc.spinner">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="270" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource GradientStart}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Arc.spinner.large">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="StrokeThickness" Value="3.5" />
    </Style>

</Styles>
